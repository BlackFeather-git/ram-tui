import os
import sys
import time
import signal
import socket
import shutil
import argparse
import platform
import subprocess
from datetime import datetime

__version__ = "0.2.0"
SYSTEM_OS = platform.system()

# Support NO_COLOR standard (https://no-color.org) and dumb terminals
USE_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"

if USE_COLOR:
    C_RESET = "\033[0m"
    C_BOLD = "\033[1m"
    C_DIM = "\033[2m"
    C_CYAN = "\033[38;2;80;200;220m"
    C_BLUE = "\033[38;2;100;160;255m"
    C_GREEN = "\033[38;2;75;210;110m"
    C_YELLOW = "\033[38;2;240;200;80m"
    C_RED = "\033[38;2;240;90;90m"
    C_GRAY = "\033[38;2;140;145;155m"
    C_DARK_GRAY = "\033[38;2;65;70;80m"
    C_WHITE = "\033[38;2;235;240;245m"
else:
    C_RESET = C_BOLD = C_DIM = ""
    C_CYAN = C_BLUE = C_GREEN = C_YELLOW = C_RED = C_GRAY = C_DARK_GRAY = C_WHITE = ""

BLOCK_FULL = "█"
BLOCK_TRACK = "░"
BLOCK_BORDER_L = "["
BLOCK_BORDER_R = "]"

PAGE_SIZE = os.sysconf("SC_PAGE_SIZE") if hasattr(os, "sysconf") else 4096


class TerminalManager:
    """Manages raw terminal state, cursor visibility, and cross-platform non-blocking input."""
    def __init__(self):
        self.is_tty = sys.stdout.isatty()
        self.orig_termios = None
        if SYSTEM_OS == "Windows":
            # Enable ANSI escape sequences on Windows console
            try:
                import ctypes
                kernel32 = ctypes.windll.kernel32
                kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
            except Exception:
                pass
        elif self.is_tty:
            try:
                import termios
                self.orig_termios = termios.tcgetattr(sys.stdin)
            except Exception:
                self.orig_termios = None

    def setup_raw(self):
        if self.is_tty:
            if SYSTEM_OS != "Windows" and self.orig_termios:
                try:
                    import tty
                    tty.setcbreak(sys.stdin.fileno())
                except Exception:
                    pass
            sys.stdout.write("\033[?25l")  # Hide cursor
            sys.stdout.flush()

    def restore(self):
        if self.is_tty:
            sys.stdout.write(f"\033[?25h{C_RESET}\n")  # Show cursor & reset styles
            sys.stdout.flush()
            if SYSTEM_OS != "Windows" and self.orig_termios:
                try:
                    import termios
                    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.orig_termios)
                except Exception:
                    pass

    def check_key(self):
        """Non-blocking key reader across Linux, macOS, and Windows."""
        if not self.is_tty:
            return None
        if SYSTEM_OS == "Windows":
            try:
                import msvcrt
                if msvcrt.kbhit():
                    ch = msvcrt.getch()
                    try:
                        return ch.decode("utf-8", errors="ignore")
                    except Exception:
                        return None
            except Exception:
                return None
        else:
            try:
                import select
                r, _, _ = select.select([sys.stdin], [], [], 0)
                if r:
                    return sys.stdin.read(1)
            except Exception:
                return None
        return None


def format_bytes(bytes_val, precision=2):
    """Formats raw bytes into human-readable B, KB, MB, or GB string."""
    if bytes_val < 1024:
        return f"{bytes_val} B"
    elif bytes_val < 1024**2:
        return f"{bytes_val / 1024:.{precision}f} KB"
    elif bytes_val < 1024**3:
        return f"{bytes_val / (1024**2):.{precision}f} MB"
    else:
        return f"{bytes_val / (1024**3):.{precision}f} GB"


def get_meminfo_linux():
    """Parses /proc/meminfo on Linux."""
    info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    key = parts[0].strip()
                    val_str = parts[1].strip().split()[0]
                    info[key] = int(val_str) * 1024
    except Exception:
        pass

    total = info.get("MemTotal", 1)
    available = info.get("MemAvailable", info.get("MemFree", 0))
    used = max(0, total - available)
    commit_as = info.get("Committed_AS", 0)
    commit_limit = info.get("CommitLimit", total)
    cached = info.get("Cached", 0) + info.get("Buffers", 0) + info.get("SReclaimable", 0)
    swap_total = info.get("SwapTotal", 0)
    swap_free = info.get("SwapFree", 0)
    swap_used = max(0, swap_total - swap_free)

    # Detect swap type
    has_zram = False
    has_disk = False
    try:
        with open("/proc/swaps", "r") as f:
            for line in f.readlines()[1:]:
                parts = line.split()
                if parts:
                    if "zram" in parts[0]:
                        has_zram = True
                    else:
                        has_disk = True
    except Exception:
        pass

    if has_zram and has_disk:
        swap_desc = "zram + disk"
    elif has_zram:
        swap_desc = "zram - compressed, costs CPU not disk"
    elif has_disk:
        swap_desc = "disk swap"
    else:
        swap_desc = "no active swap"

    return {
        "total": total,
        "available": available,
        "used": used,
        "commit_as": commit_as,
        "commit_limit": commit_limit,
        "cached": cached,
        "swap_used": swap_used,
        "swap_total": swap_total,
        "swap_desc": swap_desc,
    }


def get_meminfo_windows():
    """Fetches memory statistics on Windows using GlobalMemoryStatusEx via ctypes."""
    try:
        import ctypes
        class MEMORYSTATUSEX(ctypes.Structure):
            _fields_ = [
                ("dwLength", ctypes.c_ulong),
                ("dwMemoryLoad", ctypes.c_ulong),
                ("ullTotalPhys", ctypes.c_ulonglong),
                ("ullAvailPhys", ctypes.c_ulonglong),
                ("ullTotalPageFile", ctypes.c_ulonglong),
                ("ullAvailPageFile", ctypes.c_ulonglong),
                ("ullTotalVirtual", ctypes.c_ulonglong),
                ("ullAvailVirtual", ctypes.c_ulonglong),
                ("ullAvailExtendedVirtual", ctypes.c_ulonglong),
            ]
        stat = MEMORYSTATUSEX()
        stat.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
        ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(stat))

        total = stat.ullTotalPhys
        available = stat.ullAvailPhys
        used = total - available
        commit_limit = stat.ullTotalPageFile
        commit_as = commit_limit - stat.ullAvailPageFile
        cached = 0  # Reclaimable standby memory in Windows
        swap_total = max(0, commit_limit - total)
        swap_used = max(0, commit_as - used)
        swap_desc = "pagefile on disk"

        return {
            "total": total,
            "available": available,
            "used": used,
            "commit_as": commit_as,
            "commit_limit": commit_limit,
            "cached": cached,
            "swap_used": swap_used,
            "swap_total": swap_total,
            "swap_desc": swap_desc,
        }
    except Exception:
        return {"total": 1, "available": 0, "used": 0, "commit_as": 0, "commit_limit": 1, "cached": 0, "swap_used": 0, "swap_total": 0, "swap_desc": "unknown"}


def get_meminfo_darwin():
    """Fetches memory statistics on macOS using sysctl and vm_stat."""
    try:
        # Total memory
        total_str = subprocess.check_output(["sysctl", "-n", "hw.memsize"], text=True).strip()
        total = int(total_str)

        # vm_stat
        vm_out = subprocess.check_output(["vm_stat"], text=True)
        page_size = 4096
        free_pages = active_pages = inactive_pages = speculative_pages = wired_pages = compressed_pages = 0
        for line in vm_out.splitlines():
            if "page size of" in line:
                parts = line.split()
                for p in parts:
                    if p.isdigit():
                        page_size = int(p)
            elif "Pages free:" in line:
                free_pages = int(line.split(":")[1].strip().rstrip("."))
            elif "Pages active:" in line:
                active_pages = int(line.split(":")[1].strip().rstrip("."))
            elif "Pages inactive:" in line:
                inactive_pages = int(line.split(":")[1].strip().rstrip("."))
            elif "Pages speculative:" in line:
                speculative_pages = int(line.split(":")[1].strip().rstrip("."))
            elif "Pages wired down:" in line:
                wired_pages = int(line.split(":")[1].strip().rstrip("."))
            elif "Pages occupied by compressor:" in line:
                compressed_pages = int(line.split(":")[1].strip().rstrip("."))

        available = (free_pages + inactive_pages + speculative_pages) * page_size
        used = total - available
        cached = (inactive_pages + speculative_pages) * page_size

        # Swap
        swap_used = swap_total = 0
        try:
            swap_str = subprocess.check_output(["sysctl", "-n", "vm.swapusage"], text=True).strip()
            # e.g., total = 2048.00M  used = 512.00M  free = 1536.00M
            parts = swap_str.split()
            for i, p in enumerate(parts):
                if p == "total" and i + 2 < len(parts):
                    val = float(parts[i + 2].rstrip("M").rstrip("G"))
                    mult = 1024**3 if "G" in parts[i+2] else 1024**2
                    swap_total = int(val * mult)
                elif p == "used" and i + 2 < len(parts):
                    val = float(parts[i + 2].rstrip("M").rstrip("G"))
                    mult = 1024**3 if "G" in parts[i+2] else 1024**2
                    swap_used = int(val * mult)
        except Exception:
            pass

        return {
            "total": total,
            "available": available,
            "used": used,
            "commit_as": used + swap_used,
            "commit_limit": total + swap_total,
            "cached": cached,
            "swap_used": swap_used,
            "swap_total": swap_total,
            "swap_desc": "compressed RAM + disk swap",
        }
    except Exception:
        return {"total": 1, "available": 0, "used": 0, "commit_as": 0, "commit_limit": 1, "cached": 0, "swap_used": 0, "swap_total": 0, "swap_desc": "unknown"}


def get_meminfo():
    """Cross-platform memory information dispatcher."""
    if SYSTEM_OS == "Linux":
        return get_meminfo_linux()
    elif SYSTEM_OS == "Windows":
        return get_meminfo_windows()
    elif SYSTEM_OS == "Darwin":
        return get_meminfo_darwin()
    else:
        return get_meminfo_linux()


def get_processes(group_by_name=True):
    """Scans active processes across Linux, macOS, and Windows."""
    procs = {}

    if SYSTEM_OS == "Linux":
        try:
            pids = [p for p in os.listdir("/proc") if p.isdigit()]
        except Exception:
            pids = []

        for pid in pids:
            try:
                with open(f"/proc/{pid}/statm", "r") as f:
                    fields = f.read().split()
                    if len(fields) < 2:
                        continue
                    rss_bytes = int(fields[1]) * PAGE_SIZE
                    if rss_bytes <= 0:
                        continue

                comm = None
                try:
                    with open(f"/proc/{pid}/comm", "r") as f:
                        comm = f.read().strip()
                except Exception:
                    pass

                if not comm:
                    try:
                        with open(f"/proc/{pid}/cmdline", "rb") as f:
                            cmd = f.read().decode(errors="ignore").replace("\x00", " ").strip()
                            if cmd:
                                comm = os.path.basename(cmd.split()[0])
                    except Exception:
                        pass

                if not comm:
                    comm = f"PID {pid}"

                if group_by_name:
                    if comm in procs:
                        procs[comm]["rss"] += rss_bytes
                        procs[comm]["count"] += 1
                    else:
                        procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1}
                else:
                    procs[pid] = {"name": f"{comm} [{pid}]", "rss": rss_bytes, "count": 1}

            except (PermissionError, ProcessLookupError, FileNotFoundError, ValueError):
                continue
            except Exception:
                continue

    elif SYSTEM_OS == "Windows":
        try:
            # Fast tasklist parse on Windows
            output = subprocess.check_output(["tasklist", "/FO", "CSV", "/NH"], text=True, errors="ignore")
            for line in output.splitlines():
                parts = [p.strip(' "') for p in line.split('","')]
                if len(parts) >= 5:
                    name = parts[0]
                    pid = parts[1]
                    mem_str = parts[4].replace(",", "").replace(" K", "").replace(" KB", "").strip()
                    if mem_str.isdigit():
                        rss_bytes = int(mem_str) * 1024
                        if group_by_name:
                            if name in procs:
                                procs[name]["rss"] += rss_bytes
                                procs[name]["count"] += 1
                            else:
                                procs[name] = {"name": name, "rss": rss_bytes, "count": 1}
                        else:
                            procs[pid] = {"name": f"{name} [{pid}]", "rss": rss_bytes, "count": 1}
        except Exception:
            pass

    elif SYSTEM_OS == "Darwin":
        try:
            # Fast ps parse on macOS
            output = subprocess.check_output(["ps", "-axo", "rss,comm"], text=True, errors="ignore")
            for line in output.splitlines()[1:]:
                parts = line.strip().split(maxsplit=1)
                if len(parts) == 2 and parts[0].isdigit():
                    rss_bytes = int(parts[0]) * 1024
                    comm = os.path.basename(parts[1])
                    if group_by_name:
                        if comm in procs:
                            procs[comm]["rss"] += rss_bytes
                            procs[comm]["count"] += 1
                        else:
                            procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1}
                    else:
                        procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1}
        except Exception:
            pass

    sorted_procs = sorted(procs.values(), key=lambda x: x["rss"], reverse=True)
    return sorted_procs


def render_bar(ratio, width=42):
    """Renders the main memory usage bar with dynamic width and color scaling."""
    ratio = max(0.0, min(1.0, ratio))
    filled_len = int(round(width * ratio))
    empty_len = width - filled_len

    if ratio < 0.60:
        fill_color = C_GREEN
    elif ratio < 0.85:
        fill_color = C_YELLOW
    else:
        fill_color = C_RED

    bar_filled = f"{fill_color}{BLOCK_FULL * filled_len}{C_RESET}"
    bar_empty = f"{C_DARK_GRAY}{BLOCK_TRACK * empty_len}{C_RESET}"
    return f"{C_GRAY}{BLOCK_BORDER_L}{C_RESET}{bar_filled}{bar_empty}{C_GRAY}{BLOCK_BORDER_R}{C_RESET}"


def render_mini_bar(ratio, width=16):
    """Renders process proportional mini-bars."""
    ratio = max(0.0, min(1.0, ratio))
    filled_len = int(round(width * ratio))
    empty_len = width - filled_len
    bar_filled = f"{C_GREEN}{BLOCK_FULL * filled_len}{C_RESET}"
    bar_empty = f"{C_DARK_GRAY}{BLOCK_TRACK * empty_len}{C_RESET}"
    return f"{bar_filled}{bar_empty}"


def main():
    parser = argparse.ArgumentParser(
        prog="ram",
        description=f"ram-tui v{__version__} - Real-time dynamic memory monitor for all systems"
    )
    parser.add_argument("-r", "--rate", type=int, default=100, help="Refresh rate in milliseconds (default: 100)")
    parser.add_argument("-n", "--count", type=int, default=8, help="Number of top processes to display (default: 8)")
    parser.add_argument("-1", "--once", action="store_true", help="Print a single snapshot and exit")
    parser.add_argument("--no-group", action="store_true", help="Show individual process PIDs instead of grouping")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s v{__version__}")
    args = parser.parse_args()

    hostname = socket.gethostname()
    term = TerminalManager()

    def cleanup_and_exit(signum=None, frame=None):
        term.restore()
        sys.exit(0)

    try:
        signal.signal(signal.SIGINT, cleanup_and_exit)
        signal.signal(signal.SIGTERM, cleanup_and_exit)
    except Exception:
        pass

    refresh_ms = max(20, args.rate)
    proc_count = max(1, args.count)
    group_procs = not args.no_group
    paused = False
    first_render = True

    if not args.once:
        term.setup_raw()

    try:
        while True:
            # Handle non-blocking interactive keybindings
            if not args.once and term.is_tty:
                ch = term.check_key()
                if ch:
                    if ch in ("q", "Q", "\x03"):
                        break
                    elif ch in ("p", "P", " "):
                        paused = not paused
                    elif ch in ("+", "="):
                        refresh_ms = max(20, refresh_ms - 25)
                    elif ch in ("-", "_"):
                        refresh_ms = min(2000, refresh_ms + 50)
                    elif ch == "1":
                        group_procs = True
                    elif ch == "2":
                        group_procs = False

            if not paused or first_render:
                mem = get_meminfo()
                total = mem["total"]
                available = mem["available"]
                used = mem["used"]
                commit_as = mem["commit_as"]
                commit_limit = mem["commit_limit"]
                commit_pct = (commit_as / commit_limit * 100) if commit_limit > 0 else 0
                cached_bytes = mem["cached"]
                swap_used = mem["swap_used"]
                swap_total = mem["swap_total"]
                swap_desc = mem["swap_desc"]

                used_pct = (used / total) * 100 if total > 0 else 0

                # Process calculations
                procs = get_processes(group_by_name=group_procs)[:proc_count]
                proc_sum_rss = sum(p["rss"] for p in procs)
                proc_sum_pct = (proc_sum_rss / total) * 100 if total > 0 else 0

                now_str = datetime.now().strftime("%a %H:%M:%S")

                # Dynamic column responsive layout
                cols = shutil.get_terminal_size((80, 24)).columns
                bar_width = min(42, max(20, cols - 20))

                lines = []

                # Header
                header = f"{C_CYAN}{C_BOLD}RAM USAGE{C_RESET} {C_GRAY}—{C_RESET} {C_WHITE}{hostname}{C_RESET}  {C_GRAY}{now_str}{C_RESET}"
                if paused:
                    header += f"  {C_YELLOW}[PAUSED]{C_RESET}"
                lines.append(header)

                # Main Usage Bar
                bar_str = render_bar(used / total if total > 0 else 0, width=bar_width)
                if used_pct < 60:
                    pct_color = C_GREEN
                elif used_pct < 85:
                    pct_color = C_YELLOW
                else:
                    pct_color = C_RED
                lines.append(f"{bar_str} {pct_color}{C_BOLD}{used_pct:.1f}%{C_RESET}")
                lines.append("")

                # Metrics table
                lines.append(f"{C_WHITE}{C_BOLD}Used{C_RESET}    {C_GREEN}{format_bytes(used):<10}{C_RESET} {C_WHITE}{C_BOLD}Available{C_RESET}  {C_GREEN}{format_bytes(available):<10}{C_RESET} {C_WHITE}{C_BOLD}Total{C_RESET}   {C_WHITE}{format_bytes(total)}{C_RESET}")
                lines.append(f"{C_WHITE}{C_BOLD}Commit{C_RESET}  {format_bytes(commit_as)} / {format_bytes(commit_limit)}  {C_GRAY}({commit_pct:.0f}% of commit limit){C_RESET}")
                if cached_bytes > 0 or SYSTEM_OS == "Linux":
                    lines.append(f"{C_WHITE}{C_BOLD}Cached{C_RESET}  {format_bytes(cached_bytes):<10} {C_GRAY}(reclaimable on demand){C_RESET}")
                lines.append(f"{C_WHITE}{C_BOLD}Swap{C_RESET}    {format_bytes(swap_used)} / {format_bytes(swap_total)}   {C_GRAY}({swap_desc}){C_RESET}")
                lines.append("")

                # Process Section Header
                mode_str = "RESIDENT SET" if group_procs else "PROCESS PID"
                lines.append(f"{C_CYAN}{C_BOLD}TOP {len(procs)} PROCESSES BY {mode_str}{C_RESET}")

                # Process Rows
                max_proc_rss = procs[0]["rss"] if procs else 1
                for p in procs:
                    count_str = f" ({p['count']})" if p.get("count", 1) > 1 else ""
                    name_full = f"{p['name']}{count_str}"
                    name_disp = (name_full[:18] + "~") if len(name_full) > 19 else name_full.ljust(19)

                    rss_str = format_bytes(p["rss"], precision=1).rjust(9)
                    p_pct = (p["rss"] / total) * 100 if total > 0 else 0

                    mini_bar = render_mini_bar(p["rss"] / max_proc_rss, width=16)
                    lines.append(f"{C_WHITE}{name_disp}{C_RESET} {C_GREEN}{rss_str}{C_RESET}  {mini_bar}  {C_GRAY}{p_pct:>4.1f}%{C_RESET}")

                lines.append("")
                # Footer summary
                lines.append(f"{C_GRAY}These {len(procs)} account for  {C_WHITE}{format_bytes(proc_sum_rss)} ({proc_sum_pct:.0f}% of installed RAM){C_RESET}")

                output = "\n".join(lines)

                if args.once:
                    print(output)
                    break
                else:
                    sys.stdout.write(f"\033[H\033[J{output}\n")
                    sys.stdout.flush()
                    first_render = False

            time.sleep(refresh_ms / 1000.0)

    except KeyboardInterrupt:
        pass
    finally:
        term.restore()


if __name__ == "__main__":
    main()
