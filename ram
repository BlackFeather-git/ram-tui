    "56D84CC575E3459C8D7E34C88302444D0462C0AEBBE9EE3D7FDEBE3FFAA316AD",
    16,
)
RELEASE_PUBLIC_KEY_E = 65537
ASN1_SHA256_PREFIX = b"\x30\x31\x30\x0d\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x01\x05\x00\x04\x20"


def verify_release_signature(data, signature_b64):
    """Verify cryptographic RSA-2048 PKCS#1 v1.5 release signature against maintainer root of trust."""
    if not signature_b64 or not isinstance(signature_b64, str):
        return False
    try:
        clean_sig = signature_b64.strip()
        # Strict Base64 validation adhering to Python 3.6+ without version-specific validate=True kwarg
        if not re.fullmatch(r"^[A-Za-z0-9+/]+={0,2}$", clean_sig):
            return False
        sig_bytes = base64.b64decode(clean_sig)
        if len(sig_bytes) != 256:
            return False
        sig_int = int.from_bytes(sig_bytes, "big")
        # Strict RSA range check: representative must strictly satisfy 0 < s < n
        if sig_int <= 0 or sig_int >= RELEASE_PUBLIC_KEY_N:
            return False

        decrypted_int = pow(sig_int, RELEASE_PUBLIC_KEY_E, RELEASE_PUBLIC_KEY_N)
        k = (RELEASE_PUBLIC_KEY_N.bit_length() + 7) // 8
        em = decrypted_int.to_bytes(k, "big")

        expected_digest = ASN1_SHA256_PREFIX + hashlib.sha256(data).digest()
        if not (em.startswith(b"\x00\x01") and em.endswith(expected_digest)):
            return False

        pad = em[2:-len(expected_digest)]
        return pad.startswith(b"\xff") and pad.endswith(b"\x00") and all(b == 255 for b in pad[:-1])
    except Exception:
        return False


def parse_semver(value):
    """Parse a strict MAJOR.MINOR.PATCH semantic version adhering strictly to SemVer 2.0.0."""
    if not isinstance(value, str):
        return None
    match = UPDATE_VERSION_RE.match(value.strip())
    if not match:
        return None

    major, minor, patch, prerelease = match.groups()
    pre_parts = None
    if prerelease is not None:
        parsed_parts = []
        for part in prerelease.split("."):
            if not part:
                return None
            if part.isdigit():
                if len(part) > 1 and part.startswith("0"):
                    return None  # SemVer 2.0.0 forbids leading zeros in numeric prerelease identifiers
                parsed_parts.append((0, int(part)))
            else:
                parsed_parts.append((1, part))
        pre_parts = tuple(parsed_parts)

    return (int(major), int(minor), int(patch), pre_parts)


def is_newer_version(current, latest):
    """Return True when latest is semantically newer than current."""
    current_parsed = parse_semver(current)
    latest_parsed = parse_semver(latest)
    if current_parsed is None or latest_parsed is None:
        return False

    current_core = current_parsed[:3]
    latest_core = latest_parsed[:3]
    if latest_core != current_core:
        return latest_core > current_core

    current_pre = current_parsed[3]
    latest_pre = latest_parsed[3]
    if current_pre is None:
        return False
    if latest_pre is None:
        return True
    return latest_pre > current_pre


def parse_update_interval(value):
    """Parse seconds or s/m/h suffixes for background update checks. Never crashes."""
    if value is None:
        return UPDATE_DEFAULT_INTERVAL
    try:
        val_str = str(value).strip().lower()
        if val_str.isdigit():
            seconds = int(val_str)
        else:
            match = re.fullmatch(r"(\d+)([smh])", val_str)
            if not match:
                return UPDATE_DEFAULT_INTERVAL
            amount, suffix = match.groups()
            multiplier = {"s": 1, "m": 60, "h": 3600}[suffix]
            seconds = int(amount) * multiplier

        if seconds <= 0:
            return UPDATE_DEFAULT_INTERVAL
        return seconds
    except Exception:
        return UPDATE_DEFAULT_INTERVAL


def detect_package_manager_install(target_path):
    """Detect if target path appears to belong to a managed system package."""
    if not target_path:
        return None
    raw_norm = str(target_path).replace("\\", "/").lower()
    abs_norm = os.path.normpath(os.path.abspath(target_path)).replace("\\", "/").lower()

    for norm in (raw_norm, abs_norm):
        if norm.startswith(("/usr/bin", "/usr/sbin", "/bin", "/sbin", "/usr/lib")):
            return "system package manager (e.g. pacman, apt, dnf)"
        if norm.startswith(("/opt/homebrew", "/usr/local/cellar", "/home/linuxbrew/.linuxbrew")):
            return "Homebrew (brew)"
        if "/scoop/apps/" in norm or "/scoop/shims/" in norm:
            return "Scoop"

    return None


def _extract_ast_version(tree):
    """Extract module-level __version__ declaration from an AST tree."""
    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id == "__version__":
                    if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                        return node.value.value
                    elif isinstance(node.value, ast.Str):
                        return node.value.s
        elif isinstance(node, ast.AnnAssign):
            if isinstance(node.target, ast.Name) and node.target.id == "__version__":
                if node.value and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                    return node.value.value
                elif node.value and isinstance(node.value, ast.Str):
                    return node.value.s
    return None


def _has_ast_main_block(tree):
    """Verify presence of module-level if __name__ == '__main__': entry point block."""
    for node in tree.body:
        if isinstance(node, ast.If):
            test = node.test
            if isinstance(test, ast.Compare):
                left = test.left
                if isinstance(left, ast.Name) and left.id == "__name__":
                    for op, comp in zip(test.ops, test.comparators):
                        if isinstance(op, ast.Eq):
                            if isinstance(comp, ast.Constant) and comp.value == "__main__":
                                return True
                            elif isinstance(comp, ast.Str) and comp.s == "__main__":
                                return True
    return False


def _is_pid_alive(pid):
    """Check if a process ID is actively running on the local system."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    if SYSTEM_OS == "Windows":
        try:
            INVALID_HANDLE = ctypes.c_void_p(-1).value
            h = k32.OpenProcess(0x0400 | 0x0010, False, pid)
            if h and h != INVALID_HANDLE:
                k32.CloseHandle(h)
                return True
            return False
        except Exception:
            return False
    else:
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        except OSError:
            return False


class UpdateManager:
    """Offline-first update checker and cryptographic in-place updater."""

    def __init__(self, current_version, disabled=False, cache_path=None, interval=None):
        self.current_version = current_version
        self.disabled = bool(disabled)
        self.interval = (
            UPDATE_DEFAULT_INTERVAL if self.disabled else
            parse_update_interval(
                interval if interval is not None
                else os.environ.get("RAM_UPDATE_INTERVAL")
            )
        )
        self.cache_path = cache_path or self._default_cache_path()
        self._lock = threading.Lock()
        self._state = self.read_cache()

    @staticmethod
    def _default_cache_path():
        if SYSTEM_OS == "Windows":
            root = os.environ.get("LOCALAPPDATA")
            if root:
                return os.path.join(root, "ram-tui", "update_check.json")
        else:
            root = os.environ.get("XDG_CACHE_HOME")
            if root:
                return os.path.join(root, "ram-tui", "update_check.json")

        return os.path.expanduser("~/.cache/ram-tui/update_check.json")

    def read_cache(self):
        try:
            with open(self.cache_path, "r", encoding="utf-8") as handle:
                data = json.load(handle)

            if not isinstance(data, dict):
                return {}

            last_checked = data.get("last_checked")
            latest_version = data.get("latest_version")
            has_update = data.get("has_update")

            if not isinstance(last_checked, (int, float)):
                return {}
            if not isinstance(latest_version, str) or parse_semver(latest_version) is None:
                return {}
            if not isinstance(has_update, bool):
                return {}

            return {
                "last_checked": float(last_checked),
                "latest_version": latest_version.lstrip("v"),
                "has_update": has_update,
            }
        except (OSError, ValueError, TypeError, json.JSONDecodeError):
            return {}
        except Exception:
            return {}

    def cache_expired(self, now=None):
        with self._lock:
            state = dict(self._state)
        last_checked = state.get("last_checked")
        if last_checked is None:
            return True

        now = time.time() if now is None else float(now)
        return (now - last_checked) > self.interval

    def get_notification(self):
        with self._lock:
            state = dict(self._state)

        if state.get("has_update") and state.get("latest_version"):
            return (
                f"[Update available: v{self.current_version} -> "
                f"v{state['latest_version']} | run 'ram --update']"
            )
        return None

    def _save_cache(self, latest_version):
        state = {
            "last_checked": time.time(),
            "latest_version": latest_version.lstrip("v"),
            "has_update": is_newer_version(self.current_version, latest_version),
        }

        cache_dir = os.path.dirname(self.cache_path)
        os.makedirs(cache_dir, mode=0o700, exist_ok=True)

        temp_name = None
        try:
            with tempfile.NamedTemporaryFile(
                mode="w",
                encoding="utf-8",
                dir=cache_dir,
                prefix=".update-check-",
                suffix=".tmp",
                delete=False,
            ) as handle:
                temp_name = handle.name
                json.dump(state, handle, sort_keys=True, separators=(",", ":"))
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())

            os.replace(temp_name, self.cache_path)
            temp_name = None
        finally:
            if temp_name:
                try:
                    os.unlink(temp_name)
                except OSError:
                    pass

        with self._lock:
            self._state = state

    @staticmethod
    def _request(url, user_agent, max_size=None):
        request = urllib.request.Request(
            url,
            headers={
                "User-Agent": user_agent,
                "Accept": "application/vnd.github+json",
            },
        )
        with urllib.request.urlopen(request, timeout=1.0) as response:
            chunks = []
            total = 0
            limit = max_size or UPDATE_MAX_SOURCE_SIZE
            while True:
                chunk = response.read(16384)
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError(f"response exceeded safety limit of {limit} bytes")
                chunks.append(chunk)
            data = b"".join(chunks)
            if not data:
                raise ValueError("empty response received")
            return data

    def fetch_latest_version(self):
        user_agent = f"ram-tui/{self.current_version}"
        raw = self._request(UPDATE_API_URL, user_agent, max_size=UPDATE_MAX_API_SIZE)
        try:
            payload = json.loads(raw.decode("utf-8"))
        except Exception as exc:
            raise ValueError("GitHub API returned invalid JSON") from exc

        if not isinstance(payload, dict):
            raise ValueError("GitHub API returned invalid payload structure")

        tag_name = payload.get("tag_name")
        parsed = parse_semver(tag_name)
        if parsed is None:
            raise ValueError(f"GitHub returned an invalid release tag: '{tag_name}'")
        return tag_name.lstrip("v")

    def _download_source(self, latest_version):
        user_agent = f"ram-tui/{self.current_version}"
        url = f"{UPDATE_RAW_BASE_URL}/v{latest_version}/ram"
        return self._request(url, user_agent, max_size=UPDATE_MAX_SOURCE_SIZE)

    def _fetch_expected_sha256(self, latest_version):
        user_agent = f"ram-tui/{self.current_version}"
        url = f"{UPDATE_RAW_BASE_URL}/v{latest_version}/ram.sha256"
        try:
            raw = self._request(url, user_agent, max_size=4096)
            text = raw.decode("utf-8").strip()
            # Strict document match: exactly 64-hex digest optionally followed by whitespace & filename
            match = re.fullmatch(r"^\s*([0-9a-fA-F]{64})(?:\s+[*]?\S+)?\s*$", text)
            if match:
                return match.group(1).lower()
            raise ValueError(f"malformed SHA-256 checksum asset format for release v{latest_version}")
        except Exception as exc:
            raise ValueError(f"failed to retrieve cryptographic SHA-256 release digest: {exc}") from exc

    def _fetch_expected_signature(self, latest_version):
        user_agent = f"ram-tui/{self.current_version}"
        url = f"{UPDATE_RAW_BASE_URL}/v{latest_version}/ram.sig"
        try:
            raw = self._request(url, user_agent, max_size=2048)
            text = raw.decode("utf-8").strip()
            if len(text) >= 128:
                return text
            raise ValueError(f"malformed digital release signature for v{latest_version}")
        except Exception as exc:
            raise ValueError(f"failed to retrieve cryptographic release signature: {exc}") from exc

    @staticmethod
    def _validate_source(data, expected_version, expected_sha256=None, expected_sig=None, filename="ram"):
        if len(data) > UPDATE_MAX_SOURCE_SIZE:
            raise ValueError("downloaded source exceeds safety limit")
        if not data:
            raise ValueError("downloaded source is empty")

        # 1. Strict Cryptographic SHA-256 integrity verification
        if not expected_sha256 or len(expected_sha256) != 64 or not all(c in "0123456789abcdefABCDEF" for c in expected_sha256):
            raise ValueError("invalid or missing cryptographic SHA-256 release digest")

        computed_sha = hashlib.sha256(data).hexdigest().lower().strip()
        clean_expected = expected_sha256.lower().strip()
        if computed_sha != clean_expected:
            raise ValueError(
                f"cryptographic integrity verification failed (SHA-256 mismatch): "
                f"expected {clean_expected[:12]}..., computed {computed_sha[:12]}..."
            )

        # 2. Independent Root of Trust: Maintainer Digital RSA-2048 Signature Verification
        if not expected_sig or not verify_release_signature(data, expected_sig):
            raise ValueError("cryptographic maintainer digital signature verification failed (independent root of trust violation)")

        # 3. UTF-8 decoding
        try:
            source = data.decode("utf-8")
        except UnicodeDecodeError as exc:
            raise ValueError("downloaded file is not valid UTF-8 Python source") from exc

        # 4. Bytecode compilation
        try:
            compile(source, filename, "exec")
        except SyntaxError as exc:
            raise ValueError(f"downloaded file contains invalid Python syntax: {exc}") from exc

        # 5. AST semantic verification
        try:
            tree = ast.parse(source, filename=filename)
        except Exception as exc:
            raise ValueError(f"failed to parse downloaded source AST: {exc}") from exc

        actual_version = _extract_ast_version(tree)
        if not actual_version:
            raise ValueError("downloaded source has no valid module-level __version__ declaration")

        if parse_semver(actual_version) is None:
            raise ValueError(f"downloaded source has an invalid __version__: '{actual_version}'")

        if parse_semver(actual_version) != parse_semver(expected_version):
            raise ValueError(
                f"downloaded source version {actual_version} does not match "
                f"release version {expected_version}"
            )

        if not _has_ast_main_block(tree):
            raise ValueError("downloaded source lacks a valid 'if __name__ == \"__main__\":' entry point block")

    @staticmethod
    def _resolve_target(target_path=None):
        target = target_path or sys.argv[0]
        abs_target = os.path.abspath(target)
        is_symlink = os.path.islink(abs_target)
        real_target = os.path.realpath(abs_target)
        if not os.path.isfile(real_target):
            raise FileNotFoundError(f"installed executable not found: {real_target}")

        # AST Target Authentication: strictly authenticate existing target as ram-tui
        try:
            with open(real_target, "r", encoding="utf-8", errors="ignore") as f:
                target_src = f.read(65536)
            if "ram-tui" not in target_src:
                raise ValueError("missing authentic 'ram-tui' identity banner")
            target_tree = ast.parse(target_src, filename=real_target)
            if not _extract_ast_version(target_tree):
                raise ValueError("missing valid module-level __version__ declaration")
        except Exception as exc:
            raise ValueError(f"target does not appear to be a valid ram-tui installation: {exc}") from exc

        # Privileged directory security: fail closed without swallowing PermissionError
        if SYSTEM_OS != "Windows" and hasattr(os, "geteuid") and os.geteuid() == 0:
            parent_dir = os.path.dirname(real_target) or "."
            try:
                st = os.stat(parent_dir)
            except OSError as exc:
                raise PermissionError(f"cannot inspect target parent directory security: {exc}") from exc
            if (st.st_mode & 0o002) and not (st.st_mode & 0o1000):
                raise PermissionError(f"refusing to update binary in insecure world-writable directory: {parent_dir}")

        return real_target, is_symlink, abs_target

    def _atomic_replace(self, data, target_path):
        target_dir = os.path.dirname(target_path) or "."
        if not os.access(target_dir, os.W_OK):
            raise PermissionError(
                f"directory is not writable: {target_dir}"
            )

        # TOCTOU guard: ensure target has not been replaced with a symlink right before replacement
        if os.path.islink(target_path):
            raise PermissionError(f"TOCTOU violation: target file was replaced with a symlink: {target_path}")

        temp_name = None
        try:
            with tempfile.NamedTemporaryFile(
                mode="wb",
                dir=target_dir,
                prefix=".ram-update-",
                suffix=".tmp",
                delete=False,
            ) as handle:
                temp_name = handle.name
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())

            if SYSTEM_OS != "Windows":
                os.chmod(temp_name, 0o755)

            # Re-verify target immediately before atomic rename
            if os.path.islink(target_path):
                raise PermissionError(f"TOCTOU violation: target file was swapped for a symlink: {target_path}")

            os.replace(temp_name, target_path)
            temp_name = None
        finally:
            if temp_name:
                try:
                    os.unlink(temp_name)
                except OSError:
                    pass

    def _acquire_process_lock(self):
        lock_path = self.cache_path + ".lock"
        try:
            cache_dir = os.path.dirname(self.cache_path)
            os.makedirs(cache_dir, mode=0o700, exist_ok=True)
            if os.path.exists(lock_path):
                try:
                    with open(lock_path, "r", encoding="utf-8") as f:
                        content = f.read().strip().split()
                    if content and content[0].isdigit():
                        owner_pid = int(content[0])
                        owner_start = content[1] if len(content) > 1 else None

                        # PID Reuse Protection: verify process starttime on Linux
                        if SYSTEM_OS == "Linux" and owner_start is not None and owner_start != "0":
                            current_start = get_linux_proc_starttime(owner_pid)
                            if current_start is None or str(current_start) != str(owner_start):
                                os.unlink(lock_path)
                            else:
                                return None  # Genuine owner still actively running
                        elif not _is_pid_alive(owner_pid):
                            os.unlink(lock_path)
                        else:
                            return None  # Genuine owner still active
                except (OSError, ValueError):
                    pass

            start_val = get_linux_proc_starttime(os.getpid()) if SYSTEM_OS == "Linux" else "0"
            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.write(fd, f"{os.getpid()} {start_val or '0'} {time.time()}\n".encode("utf-8"))
            os.close(fd)
            return lock_path
        except (OSError, Exception):
            return None

    def _release_process_lock(self, lock_path):
        if lock_path:
            try:
                os.unlink(lock_path)
            except OSError:
                pass

    def check_now(self):
        """Synchronously check GitHub and update the local cache."""
        latest = self.fetch_latest_version()
        self._save_cache(latest)
        return latest, is_newer_version(self.current_version, latest)

    def start_background_check(self):
        """Start a daemon check only when the cache is expired and enabled."""
        if self.disabled or not self.cache_expired():
            return False

        thread = threading.Thread(
            target=self._background_worker,
            name="ram-update-check",
            daemon=True,
        )
        thread.start()
        return True

    def _background_worker(self):
        lock = self._acquire_process_lock()
        if not lock:
            return
        try:
            self.check_now()
        except Exception:
            # Background update checks must never affect the main UI.
            return
        finally:
            self._release_process_lock(lock)

    def perform_update(self, target_path=None, force=False):
        """Download, validate cryptographically & semantically, and atomically replace."""
        try:
            latest, has_update = self.check_now()
        except Exception as exc:
            return False, f"ram-tui update check failed: {exc}"

        if not has_update:
            return True, f"ram-tui is already up to date (v{latest})"

        try:
            real_target, is_symlink, abs_target = self._resolve_target(target_path)

            # Package manager conflict detection
            pkg_mgr = detect_package_manager_install(real_target)
            if pkg_mgr and not force:
                return (
                    False,
                    f"Notice: ram-tui is installed in a package-managed path ({real_target}) "
                    f"managed by {pkg_mgr}.\n"
                    "Self-updating will desynchronize your package manager database.\n"
                    "Please update via your package manager, or run 'ram --update --force' to override."
                )

            data = self._download_source(latest)
            expected_sha256 = self._fetch_expected_sha256(latest)
            expected_sig = self._fetch_expected_signature(latest)
            self._validate_source(data, latest, expected_sha256=expected_sha256, expected_sig=expected_sig, filename=real_target)
            self._atomic_replace(data, real_target)

            msg = f"ram-tui updated successfully: v{self.current_version} -> v{latest}"
            if is_symlink:
                msg += f" (symlink target: {real_target})"
            return True, msg
        except PermissionError as exc:
            return (
                False,
                f"ram-tui update permission error: {exc}.\n"
                "Try 'sudo ram --update' for a system install, or update through your package manager.",
            )
        except OSError as exc:
            return False, (
                "ram-tui could not replace the installed executable: "
                f"{exc}. On Windows, close any process holding the script "
                "open and retry."
            )
        except Exception as exc:
            return False, f"ram-tui update aborted safely: {exc}"


