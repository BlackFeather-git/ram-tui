# Maintainer Root of Trust: Embedded RSA-2048 Public Verification Key
RELEASE_PUBLIC_KEY_N = int(
    "9914D5370F8E6A3154C27101021400390B2D4B5AC775670EE25C5EE0F2A1E6AC"
    "2677C9D94926EDF062443CE740B38193D25D67678055EE9731721163FF98BF0E"
