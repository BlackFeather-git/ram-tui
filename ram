                else:
                    procs[pid] = {"name": f"{comm} [{pid}]", "rss": rss_bytes, "count": 1, "pid": pid}
    except Exception:
        pass

    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes(group_by_name=True, limit=8):
    if SYSTEM_OS == "Linux":
