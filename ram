def get_meminfo_linux():
    info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                parts = line.split(":", maxsplit=1)
                if len(parts) == 2:
                    key = parts[0].strip()
                    val_parts = parts[1].strip().split()
                    if val_parts:
                        try:
                            info[key] = int(val_parts[0]) * 1024
                        except ValueError:
                            pass
    except Exception:
        return {"total": 0, "available": 0, "used": 0, "commit_as": 0, "commit_limit": 0, "cached": 0, "swap_used": 0, "swap_total": 0, "swap_desc": "unknown", "valid": False}

    total = max(0, info.get("MemTotal", 0))
    available = max(0, info.get("MemAvailable", info.get("MemFree", 0)))
    used = max(0, total - available)
    commit_as = max(0, info.get("Committed_AS", 0))
    commit_limit = max(0, info.get("CommitLimit", total))
    cached = max(0, info.get("Cached", 0) + info.get("Buffers", 0) + info.get("SReclaimable", 0))
    swap_total = max(0, info.get("SwapTotal", 0))
    swap_free = max(0, info.get("SwapFree", 0))
    swap_used = max(0, swap_total - swap_free)

    has_zram = False
    has_disk = False
    try:
        with open("/proc/swaps", "r") as f:
            for line in f.readlines()[1:]:
                line = line.strip()
                if not line:
                    continue
                parts = line.split()
                if parts:
                    if "zram" in parts[0]:
                        has_zram = True
                    else:
                        has_disk = True
    except Exception:
        pass

    if not has_zram:
        try:
            if os.path.exists("/sys/block") and any(p.startswith("zram") for p in os.listdir("/sys/block")):
                has_zram = True
        except Exception:
            pass

    if has_zram and has_disk:
        swap_desc = "zram + disk"
    elif has_zram:
        swap_desc = "zram"
    elif has_disk:
        swap_desc = "disk swap"
    else:
        swap_desc = "none"

    return {
        "total": total,
        "available": available,
        "used": used,
        "commit_as": commit_as,
        "commit_limit": commit_limit,
        "cached": cached,
        "swap_used": swap_used,
        "swap_total": swap_total,
        "swap_desc": swap_desc,
        "valid": total > 0,
    }


def get_meminfo_windows():
    try:
        stat = MEMORYSTATUSEX()
        stat.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
        if not k32.GlobalMemoryStatusEx(ctypes.byref(stat)):
            return {"total": 0, "available": 0, "used": 0, "commit_as": None, "commit_limit": None, "cached": None, "swap_used": None, "swap_total": 0, "swap_desc": "unknown", "valid": False}

        total = max(0, int(stat.ullTotalPhys))
        available = max(0, int(stat.ullAvailPhys))
        used = max(0, total - available)

        commit_as = None
        commit_limit = None
        cached = None
        try:
            if psapi_perf:
                perf = PERFORMANCE_INFORMATION()
                perf.cb = ctypes.sizeof(PERFORMANCE_INFORMATION)
                if psapi_perf(ctypes.byref(perf), perf.cb):
                    page_size = perf.PageSize or 4096
                    commit_as = max(0, int(perf.CommitTotal * page_size))
                    commit_limit = max(0, int(perf.CommitLimit * page_size))
                    cached = max(0, int(perf.SystemCache * page_size))
        except Exception:
            commit_as = None
            commit_limit = None
            cached = None

        swap_total = max(0, int(stat.ullTotalPageFile) - total)
        swap_desc = "pagefile"

        return {
            "total": total,
            "available": available,
            "used": used,
            "commit_as": commit_as,
            "commit_limit": commit_limit,
            "cached": cached,
            "swap_used": None,
            "swap_total": swap_total,
            "swap_desc": swap_desc,
            "valid": total > 0,
        }
    except Exception:
        return {"total": 0, "available": 0, "used": 0, "commit_as": None, "commit_limit": None, "cached": None, "swap_used": None, "swap_total": 0, "swap_desc": "unknown", "valid": False}


def get_meminfo_darwin():
    try:
        total_str = run_command(["sysctl", "-n", "hw.memsize"], timeout=1.0).strip()
        total = max(0, int(total_str))

        vm_out = run_command(["vm_stat"], timeout=1.0)
        page_size = 4096
        free_pages = active_pages = inactive_pages = speculative_pages = wired_pages = compressed_pages = 0
        for line in vm_out.splitlines():
            line = line.strip()
            if not line:
                continue
            if "page size of" in line:
                m = re.search(r"(\d+)\s*bytes", line)
                if m:
                    page_size = max(1, int(m.group(1)))
            elif "Pages free:" in line:
                free_pages = max(0, int(re.sub(r"[^\d]", "", line.split(":")[1]) or 0))
            elif "Pages active:" in line:
                active_pages = max(0, int(re.sub(r"[^\d]", "", line.split(":")[1]) or 0))
            elif "Pages inactive:" in line:
                inactive_pages = max(0, int(re.sub(r"[^\d]", "", line.split(":")[1]) or 0))
            elif "Pages speculative:" in line:
                speculative_pages = max(0, int(re.sub(r"[^\d]", "", line.split(":")[1]) or 0))
            elif "Pages wired down:" in line:
                wired_pages = max(0, int(re.sub(r"[^\d]", "", line.split(":")[1]) or 0))
            elif "Pages occupied by compressor:" in line:
                compressed_pages = max(0, int(re.sub(r"[^\d]", "", line.split(":")[1]) or 0))

        available = max(0, (free_pages + inactive_pages + speculative_pages) * page_size)
        used = max(0, total - available)
        cached = max(0, (inactive_pages + speculative_pages) * page_size)

        swap_used = swap_total = 0
        try:
            swap_str = run_command(["sysctl", "-n", "vm.swapusage"], timeout=1.0).strip()
            matches = re.findall(r"(\w+)\s*=\s*([0-9.]+)\s*([KMGTP]?)", swap_str, re.IGNORECASE)
            units = {"K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4, "P": 1024**5}
            for k, val, unit in matches:
                mult = units.get(unit.upper(), 1024**2)
                bytes_num = max(0, int(float(val) * mult))
                if k.lower() == "total":
                    swap_total = bytes_num
                elif k.lower() == "used":
                    swap_used = bytes_num
        except Exception:
            pass

        return {
            "total": total,
            "available": available,
            "used": used,
            "commit_as": None,
            "commit_limit": None,
            "cached": cached,
            "swap_used": swap_used,
            "swap_total": swap_total,
            "swap_desc": "compressed RAM",
            "valid": total > 0,
        }
    except Exception:
        return {"total": 0, "available": 0, "used": 0, "commit_as": None, "commit_limit": None, "cached": 0, "swap_used": 0, "swap_total": 0, "swap_desc": "unknown", "valid": False}


def get_meminfo():
    if SYSTEM_OS == "Linux":
        return get_meminfo_linux()
    elif SYSTEM_OS == "Windows":
        return get_meminfo_windows()
    elif SYSTEM_OS == "Darwin":
        return get_meminfo_darwin()
    return get_meminfo_linux()


