def should_use_color(is_interactive=True):
    """Determine whether color output should be enabled based on terminal and flags."""
    if "NO_COLOR" in os.environ or os.environ.get("TERM", "").lower() == "dumb":
        return False
    if not sys.stdout.isatty():
        return False
    return is_interactive


def get_palette(theme_name="default", enable_color=True):
    """Returns ANSI codes dictionary for the active theme."""
    if not enable_color or theme_name == "monochrome" or theme_name not in THEME_PALETTES:
        return {
            "RESET": "", "BOLD": "", "DIM": "",
            "HEADER": "", "ACCENT": "", "GOOD": "", "WARNING": "",
            "CRITICAL": "", "MUTED": "", "TRACK": "", "TEXT": "",
        }
    
    t = THEME_PALETTES[theme_name]
    return {
        "RESET": "\033[0m",
        "BOLD": "\033[1m",
        "DIM": t["dim"],
        "HEADER": t["header"],
        "ACCENT": t["accent"],
        "GOOD": t["good"],
        "WARNING": t["warning"],
        "CRITICAL": t["critical"],
        "MUTED": t["muted"],
        "TRACK": t["track"],
        "TEXT": t["text"],
    }


def format_bytes(value, precision=2):
    """Return a non-negative byte count in a compact IEC unit."""
    try:
        value = max(0, int(value))
    except (TypeError, ValueError):
        value = 0

    if value < 1024:
        return f"{value} B"
    if value < 1024 ** 2:
        return f"{value / 1024.0:.{precision}f} KB"
    if value < 1024 ** 3:
        return f"{value / (1024.0 ** 2):.{precision}f} MB"
    if value < 1024 ** 4:
        return f"{value / (1024.0 ** 3):.{precision}f} GB"
    return f"{value / (1024.0 ** 4):.{precision}f} TB"


def clamp(value, low, high):
    return max(low, min(high, value))


def percentage(part, whole):
    """Return a bounded percentage; zero is used when the denominator is unknown."""
    try:
        if whole is None or whole <= 0 or part is None:
            return 0.0
        return clamp((float(part) / float(whole)) * 100.0, 0.0, 100.0)
    except (TypeError, ValueError, ZeroDivisionError):
        return 0.0


def sanitize_text(value, replacement="~"):
    """Strips full ANSI sequences, control characters, and bidi overrides from process names."""
    if value is None:
        return ""
    text = ANSI_ESCAPE_RE.sub("", str(value))
    cleaned = []
    for char in text:
        code = ord(char)
        if code < 32 or code == 127 or char in BIDI_CHARS:
            cleaned.append(replacement)
        else:
            cleaned.append(char)
    return "".join(cleaned)


def run_command(cmd, timeout=1.0):
    """Executes a command safely without shell, compatible with Python 3.6+."""
    try:
        out = subprocess.check_output(cmd, universal_newlines=True, timeout=timeout, errors="ignore")
        return out
    except Exception:
        return ""


class TerminalManager:
    """Manages raw terminal state, alternate screen buffer, cursor, and instantaneous non-blocking input."""
    def __init__(self):
        self.is_tty = sys.stdout.isatty() and sys.stdin.isatty()
        self.orig_termios = None
        self.fd = None
        self.h_stdout = None
        self.orig_console_mode = None
        self._restored = False
        self._raw_active = False
        self._alt_screen_active = False

        if self.is_tty:
            try:
                self.fd = sys.stdin.fileno()
            except Exception:
                self.is_tty = False

        if SYSTEM_OS == "Windows" and self.is_tty:
            try:
                kernel32 = ctypes.windll.kernel32
                self.h_stdout = kernel32.GetStdHandle(0xFFFFFFF5)
                mode = ctypes.c_ulong()
                if kernel32.GetConsoleMode(self.h_stdout, ctypes.byref(mode)):
                    self.orig_console_mode = mode.value
            except Exception:
                pass
        elif self.is_tty and self.fd is not None:
            try:
                import termios
                self.orig_termios = termios.tcgetattr(self.fd)
            except Exception:
                self.orig_termios = None

    def setup_raw(self):
        if not self.is_tty or self._raw_active:
            return
        self._raw_active = True
        self._restored = False

        if SYSTEM_OS == "Windows":
            try:
                if self.h_stdout is not None and self.orig_console_mode is not None:
                    ctypes.windll.kernel32.SetConsoleMode(self.h_stdout, self.orig_console_mode | 7)
            except Exception:
                pass
        elif self.orig_termios and self.fd is not None:
            try:
                import tty
                tty.setcbreak(self.fd)
            except Exception:
                pass
        try:
            # Switch to Alternate Screen Buffer, hide cursor, and clear screen
            sys.stdout.write("\033[?1049h\033[?25l\033[H\033[2J")
            sys.stdout.flush()
            self._alt_screen_active = True
        except Exception:
            self._alt_screen_active = False

    def restore(self):
        if self._restored:
            return
        self._restored = True
        self._raw_active = False

        if self.is_tty:
            try:
                if self._alt_screen_active:
                    sys.stdout.write("\033[?1049l\033[?25h\033[0m")
                else:
                    sys.stdout.write("\033[?25h\033[0m")
                sys.stdout.flush()
            except Exception:
                pass
            self._alt_screen_active = False

            if SYSTEM_OS == "Windows":
                if self.h_stdout is not None and self.orig_console_mode is not None:
                    try:
                        ctypes.windll.kernel32.SetConsoleMode(self.h_stdout, self.orig_console_mode)
                    except Exception:
                        pass
            elif self.orig_termios and self.fd is not None:
                try:
                    import termios
                    termios.tcsetattr(self.fd, termios.TCSADRAIN, self.orig_termios)
                except Exception:
                    pass

    def get_keys(self, timeout=0.0):
        """Wait up to timeout seconds for keypresses and return list of characters immediately."""
        if not self.is_tty:
            if timeout > 0:
                time.sleep(timeout)
            return []

        if SYSTEM_OS == "Windows":
            try:
                import msvcrt
                deadline = time.monotonic() + timeout
                keys = []
                while True:
                    while msvcrt.kbhit():
                        ch = msvcrt.getch()
                        # Consume secondary scan codes for extended / arrow keys
                        if ch in (b"\x00", b"\xe0") and msvcrt.kbhit():
                            msvcrt.getch()
                            continue
                        try:
                            keys.append(ch.decode("utf-8", errors="ignore"))
                        except Exception:
                            pass
                    if keys or time.monotonic() >= deadline:
                        break
                    time.sleep(0.001)
                return keys
            except Exception:
                if timeout > 0:
                    time.sleep(timeout)
                return []
        else:
            try:
                r, _, _ = select.select([self.fd], [], [], max(0.0, timeout))
                if r:
                    data = os.read(self.fd, 64).decode("utf-8", errors="ignore")
                    return list(data)
            except Exception:
                pass
            return []


