def get_linux_proc_starttime(pid):
    try:
        with open(f"/proc/{pid}/stat", "r") as f:
            content = f.read().strip()
        rparen = content.rfind(")")
        if rparen != -1:
            fields = content[rparen + 2:].split()
            if len(fields) >= 20:
                return fields[19]
    except Exception:
        pass
    return None


def get_processes_linux(group_by_name=True, limit=8):
    global PID_NAME_CACHE
    procs = {}

    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except Exception:
        return []

    valid_keys = set()

    for pid in pids:
        try:
            starttime = get_linux_proc_starttime(pid)
            if starttime is None:
                continue

            cache_key = (pid, starttime)
            valid_keys.add(cache_key)

            with open(f"/proc/{pid}/statm", "r") as f:
                content = f.read().strip()
                if not content:
                    continue
                fields = content.split(maxsplit=2)
                if len(fields) < 2:
                    continue
                rss_bytes = int(fields[1]) * PAGE_SIZE
                if rss_bytes <= 0:
                    continue

            comm = PID_NAME_CACHE.get(cache_key)
            if not comm:
                try:
                    with open(f"/proc/{pid}/comm", "r") as f:
                        comm = f.read().strip()
                except Exception:
                    pass

                if not comm:
                    try:
                        with open(f"/proc/{pid}/cmdline", "rb") as f:
                            cmd = f.read().decode(errors="ignore").replace("\x00", " ").strip()
                            if cmd:
                                comm = os.path.basename(cmd.split()[0])
                    except Exception:
                        pass

                comm = sanitize_text(comm or f"PID {pid}")
                PID_NAME_CACHE[cache_key] = comm

            if group_by_name:
                if comm in procs:
                    procs[comm]["rss"] += rss_bytes
                    procs[comm]["count"] += 1
                else:
                    procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1, "pid": None}
            else:
                procs[pid] = {"name": f"{comm} [{pid}]", "rss": rss_bytes, "count": 1, "pid": int(pid)}

        except (PermissionError, ProcessLookupError, FileNotFoundError, ValueError):
            continue
        except Exception:
            continue

    PID_NAME_CACHE = {k: v for k, v in PID_NAME_CACHE.items() if k in valid_keys}
    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes_windows(group_by_name=True, limit=8):
    """Enumerates Windows processes with module-level ctypes caching and guarded handle cleanup."""
    procs = {}
    if SYSTEM_OS != "Windows":
        return []

    try:
        INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
        h_snap = k32.CreateToolhelp32Snapshot(0x00000002, 0)
        if not h_snap or h_snap == INVALID_HANDLE_VALUE or h_snap == -1:
            return []

        try:
            pe = PROCESSENTRY32W()
            pe.dwSize = ctypes.sizeof(PROCESSENTRY32W)
            pmc = PROCESS_MEMORY_COUNTERS()
            pmc.cb = ctypes.sizeof(PROCESS_MEMORY_COUNTERS)

            if k32.Process32FirstW(h_snap, ctypes.byref(pe)):
                while True:
                    pid = pe.th32ProcessID
                    if pid > 4:  # Skip System Idle Process (0) and System (4)
                        name = sanitize_text(pe.szExeFile)
                        h_proc = k32.OpenProcess(0x0400 | 0x0010, False, pid)
                        if h_proc and h_proc != INVALID_HANDLE_VALUE:
                            try:
                                if psapi_mem and psapi_mem(h_proc, ctypes.byref(pmc), pmc.cb):
                                    rss_bytes = pmc.WorkingSetSize
                                    if rss_bytes > 0:
                                        if group_by_name:
                                            if name in procs:
                                                procs[name]["rss"] += rss_bytes
                                                procs[name]["count"] += 1
                                            else:
                                                procs[name] = {"name": name, "rss": rss_bytes, "count": 1, "pid": None}
                                        else:
                                            procs[pid] = {"name": f"{name} [{pid}]", "rss": rss_bytes, "count": 1, "pid": pid}
                            finally:
                                try:
                                    k32.CloseHandle(h_proc)
                                except Exception:
                                    pass

                    if not k32.Process32NextW(h_snap, ctypes.byref(pe)):
                        break
        finally:
            try:
                k32.CloseHandle(h_snap)
            except Exception:
                pass

    except Exception:
        pass

    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes_darwin(group_by_name=True, limit=8):
    procs = {}
    try:
        output = run_command(["ps", "-axo", "pid,rss,comm"], timeout=1.0)
        for line in output.splitlines()[1:]:
            line = line.strip()
            if not line:
                continue
            parts = line.split(maxsplit=2)
            if len(parts) == 3 and parts[1].isdigit():
                pid = int(parts[0])
                rss_bytes = int(parts[1]) * 1024
                comm = sanitize_text(os.path.basename(parts[2]))
                if rss_bytes <= 0:
                    continue

                if group_by_name:
                    if comm in procs:
                        procs[comm]["rss"] += rss_bytes
                        procs[comm]["count"] += 1
                    else:
                        procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1, "pid": None}
                else:
                    procs[pid] = {"name": f"{comm} [{pid}]", "rss": rss_bytes, "count": 1, "pid": pid}
    except Exception:
        pass

    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes(group_by_name=True, limit=8):
    if SYSTEM_OS == "Linux":
        return get_processes_linux(group_by_name=group_by_name, limit=limit)
    elif SYSTEM_OS == "Windows":
        return get_processes_windows(group_by_name=group_by_name, limit=limit)
    elif SYSTEM_OS == "Darwin":
        return get_processes_darwin(group_by_name=group_by_name, limit=limit)
    return get_processes_linux(group_by_name=group_by_name, limit=limit)


# ---------------------------------------------------------------------------
# Update Manager & Version Lifecycle
# ---------------------------------------------------------------------------

UPDATE_API_URL = "https://api.github.com/repos/BlackFeather-git/ram-tui/releases/latest"
UPDATE_RAW_BASE_URL = "https://raw.githubusercontent.com/BlackFeather-git/ram-tui"
UPDATE_DEFAULT_INTERVAL = 60
UPDATE_MAX_SOURCE_SIZE = 2 * 1024 * 1024
UPDATE_VERSION_RE = re.compile(
    r"^v?(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
    r"(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$"
)
SOURCE_VERSION_RE = re.compile(
    r"^\s*__version__\s*=\s*['\"]([^'\"]+)['\"]\s*$",
    re.MULTILINE,
)


def parse_semver(value):
    """Parse a strict MAJOR.MINOR.PATCH semantic version."""
    if not isinstance(value, str):
        return None
    match = UPDATE_VERSION_RE.match(value.strip())
    if not match:
        return None

    major, minor, patch, prerelease = match.groups()
    pre_parts = None
    if prerelease is not None:
        parsed_parts = []
        for part in prerelease.split("."):
            if part.isdigit():
                parsed_parts.append((0, int(part)))
            else:
                parsed_parts.append((1, part))
        pre_parts = tuple(parsed_parts)

    return (int(major), int(minor), int(patch), pre_parts)


def is_newer_version(current, latest):
    """Return True when latest is semantically newer than current."""
    current_parsed = parse_semver(current)
    latest_parsed = parse_semver(latest)
    if current_parsed is None or latest_parsed is None:
        return False

    current_core = current_parsed[:3]
    latest_core = latest_parsed[:3]
    if latest_core != current_core:
        return latest_core > current_core

    current_pre = current_parsed[3]
    latest_pre = latest_parsed[3]
    if current_pre is None:
        return False
    if latest_pre is None:
        return True
    return latest_pre > current_pre


def parse_update_interval(value):
    """Parse seconds or s/m/h suffixes for background update checks."""
    if value is None:
        return UPDATE_DEFAULT_INTERVAL
    value = str(value).strip().lower()
    if value.isdigit():
        seconds = int(value)
    else:
        match = re.fullmatch(r"(\d+)([smh])", value)
        if not match:
            raise ValueError("invalid update interval")
        amount, suffix = match.groups()
        multiplier = {"s": 1, "m": 60, "h": 3600}[suffix]
        seconds = int(amount) * multiplier

    if seconds <= 0:
        raise ValueError("update interval must be positive")
    return seconds


class UpdateManager:
    """Offline-first update checker and in-place updater."""

    def __init__(self, current_version, disabled=False, cache_path=None, interval=None):
        self.current_version = current_version
        self.disabled = bool(disabled)
        self.interval = (
            parse_update_interval(
                interval if interval is not None
                else os.environ.get("RAM_UPDATE_INTERVAL")
            )
        )
        self.cache_path = cache_path or self._default_cache_path()
        self._lock = threading.Lock()
        self._state = self.read_cache()

    @staticmethod
    def _default_cache_path():
        if SYSTEM_OS == "Windows":
            root = os.environ.get("LOCALAPPDATA")
            if root:
                return os.path.join(root, "ram-tui", "update_check.json")
        else:
            root = os.environ.get("XDG_CACHE_HOME")
            if root:
                return os.path.join(root, "ram-tui", "update_check.json")

        return os.path.expanduser("~/.cache/ram-tui/update_check.json")

    def read_cache(self):
        try:
            with open(self.cache_path, "r", encoding="utf-8") as handle:
                data = json.load(handle)

            last_checked = data.get("last_checked")
            latest_version = data.get("latest_version")
            has_update = data.get("has_update")

            if not isinstance(last_checked, (int, float)):
                return {}
            if not isinstance(latest_version, str) or parse_semver(latest_version) is None:
                return {}
            if not isinstance(has_update, bool):
                return {}

            return {
                "last_checked": float(last_checked),
                "latest_version": latest_version.lstrip("v"),
                "has_update": has_update,
            }
        except (OSError, ValueError, TypeError, json.JSONDecodeError):
            return {}
        except Exception:
            return {}

    def cache_expired(self, now=None):
        state = self._state
        last_checked = state.get("last_checked")
        if last_checked is None:
            return True

        now = time.time() if now is None else float(now)
        return (now - last_checked) > self.interval

    def get_notification(self):
        with self._lock:
            state = dict(self._state)

        if state.get("has_update") and state.get("latest_version"):
            return (
                f"[Update available: v{self.current_version} -> "
                f"v{state['latest_version']} | run 'ram --update']"
            )
        return None

    def _save_cache(self, latest_version):
        state = {
            "last_checked": time.time(),
            "latest_version": latest_version.lstrip("v"),
            "has_update": is_newer_version(self.current_version, latest_version),
        }

        cache_dir = os.path.dirname(self.cache_path)
        os.makedirs(cache_dir, mode=0o700, exist_ok=True)

        temp_name = None
        try:
            with tempfile.NamedTemporaryFile(
                mode="w",
                encoding="utf-8",
                dir=cache_dir,
                prefix=".update-check-",
                suffix=".tmp",
                delete=False,
            ) as handle:
                temp_name = handle.name
                json.dump(state, handle, sort_keys=True, separators=(",", ":"))
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())

            os.replace(temp_name, self.cache_path)
            temp_name = None
        finally:
            if temp_name:
                try:
                    os.unlink(temp_name)
                except OSError:
                    pass

        with self._lock:
            self._state = state

    @staticmethod
    def _request(url, user_agent):
        request = urllib.request.Request(
            url,
            headers={
                "User-Agent": user_agent,
                "Accept": "application/vnd.github+json",
            },
        )
        return urllib.request.urlopen(request, timeout=1.0)

    def fetch_latest_version(self):
        user_agent = f"ram-tui/{self.current_version}"
        with self._request(UPDATE_API_URL, user_agent) as response:
            payload = json.loads(response.read().decode("utf-8"))

        tag_name = payload.get("tag_name")
        parsed = parse_semver(tag_name)
        if parsed is None:
            raise ValueError("GitHub returned an invalid release tag")
        return tag_name.lstrip("v")

    def _download_source(self, latest_version):
        user_agent = f"ram-tui/{self.current_version}"
        url = f"{UPDATE_RAW_BASE_URL}/v{latest_version}/ram"

        with self._request(url, user_agent) as response:
            chunks = []
            total = 0
            while True:
                chunk = response.read(65536)
                if not chunk:
                    break
                total += len(chunk)
                if total > UPDATE_MAX_SOURCE_SIZE:
                    raise ValueError("downloaded source exceeds safety limit")
                chunks.append(chunk)

        data = b"".join(chunks)
        if not data:
            raise ValueError("downloaded source is empty")
        return data

    @staticmethod
    def _validate_source(data, expected_version, filename):
        try:
            source = data.decode("utf-8")
            compile(source, filename, "exec")
        except (UnicodeDecodeError, SyntaxError) as exc:
            raise ValueError("downloaded file is not valid UTF-8 Python source") from exc

        version_match = SOURCE_VERSION_RE.search(source)
        if not version_match:
            raise ValueError("downloaded source has no __version__ declaration")

        actual_version = version_match.group(1)
        if parse_semver(actual_version) is None:
            raise ValueError("downloaded source has an invalid __version__")

        if not (
            parse_semver(actual_version)
            == parse_semver(expected_version)
        ):
            raise ValueError(
                f"downloaded source version {actual_version} does not match "
                f"release version {expected_version}"
            )

        if 'if __name__ == "__main__":' not in source:
            raise ValueError("downloaded source has no executable entry point")

    @staticmethod
    def _resolve_target(target_path=None):
        target = target_path or sys.argv[0]
        target = os.path.realpath(os.path.abspath(target))
        if not os.path.isfile(target):
            raise FileNotFoundError(f"installed executable not found: {target}")
        return target

    def _atomic_replace(self, data, target_path):
        target_dir = os.path.dirname(target_path) or "."
        if not os.access(target_dir, os.W_OK):
            raise PermissionError(
                f"directory is not writable: {target_dir}"
            )

        temp_name = None
        try:
            with tempfile.NamedTemporaryFile(
                mode="wb",
                dir=target_dir,
                prefix=".ram-update-",
                suffix=".tmp",
                delete=False,
            ) as handle:
                temp_name = handle.name
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())

            if SYSTEM_OS != "Windows":
                os.chmod(temp_name, 0o755)
            os.replace(temp_name, target_path)
            temp_name = None
        finally:
            if temp_name:
                try:
                    os.unlink(temp_name)
                except OSError:
                    pass

    def check_now(self):
        """Synchronously check GitHub and update the local cache."""
        latest = self.fetch_latest_version()
        self._save_cache(latest)
        return latest, is_newer_version(self.current_version, latest)

    def start_background_check(self):
        """Start a daemon check only when the cache is expired and enabled."""
        if self.disabled or not self.cache_expired():
            return False

        thread = threading.Thread(
            target=self._background_worker,
            name="ram-update-check",
            daemon=True,
        )
        thread.start()
        return True

    def _background_worker(self):
        try:
            self.check_now()
        except Exception:
            # Background update checks must never affect the main UI.
            return

    def perform_update(self, target_path=None):
        """Download, validate, and atomically replace the running source."""
        try:
            latest, has_update = self.check_now()
        except Exception as exc:
            return False, f"ram-tui update check failed: {exc}"

        if not has_update:
            return True, f"ram-tui is already up to date (v{latest})"

        try:
            target = self._resolve_target(target_path)
            data = self._download_source(latest)
            self._validate_source(data, latest, target)
            self._atomic_replace(data, target)
        except PermissionError:
            return (
                False,
                "ram-tui could not replace the installed executable because "
                f"the target directory is not writable: {target_path or sys.argv[0]}. "
                "Try 'sudo ram --update' for a system install, or update it "
                "through your package manager.",
            )
        except OSError as exc:
            return False, (
                "ram-tui could not replace the installed executable: "
                f"{exc}. On Windows, close any process holding the script "
                "open and retry."
            )
        except Exception as exc:
            return False, f"ram-tui update aborted safely: {exc}"

        return True, f"ram-tui updated successfully: v{self.current_version} -> v{latest}"


