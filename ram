SYSTEM_OS = platform.system()

PAGE_SIZE = 4096
if SYSTEM_OS == "Linux":
    try:
        PAGE_SIZE = int(os.sysconf("SC_PAGE_SIZE"))
    except (AttributeError, OSError, ValueError):
        PAGE_SIZE = 4096

# Process starttime-keyed cache to prevent PID-reuse race conditions
# Key: (pid, starttime_jiffies) -> process_name
PID_NAME_CACHE = {}

# ANSI escape sequence regex for complete sequence removal
ANSI_ESCAPE_RE = re.compile(r"\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")

# Unicode bidirectional control characters to strip for terminal integrity
BIDI_CHARS = set("\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069")


# ---------------------------------------------------------------------------
# Windows Win32 FFI Prototypes (Explicit Pointer-Sized Types for x64/x86)
# ---------------------------------------------------------------------------
if SYSTEM_OS == "Windows":
    try:
        k32 = ctypes.windll.kernel32
        
        # GetStdHandle(DWORD) -> HANDLE (c_void_p)
        k32.GetStdHandle.argtypes = [ctypes.c_ulong]
        k32.GetStdHandle.restype = ctypes.c_void_p

        # GetConsoleMode(HANDLE, LPDWORD) -> BOOL
        k32.GetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
        k32.GetConsoleMode.restype = ctypes.c_int

        # SetConsoleMode(HANDLE, DWORD) -> BOOL
        k32.SetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        k32.SetConsoleMode.restype = ctypes.c_int

        # CreateToolhelp32Snapshot(DWORD, DWORD) -> HANDLE (c_void_p)
        k32.CreateToolhelp32Snapshot.argtypes = [ctypes.c_ulong, ctypes.c_ulong]
        k32.CreateToolhelp32Snapshot.restype = ctypes.c_void_p

        # Process32FirstW(HANDLE, LPPROCESSENTRY32W) -> BOOL
        k32.Process32FirstW.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        k32.Process32FirstW.restype = ctypes.c_int

        # Process32NextW(HANDLE, LPPROCESSENTRY32W) -> BOOL
        k32.Process32NextW.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        k32.Process32NextW.restype = ctypes.c_int

        # OpenProcess(DWORD, BOOL, DWORD) -> HANDLE (c_void_p)
        k32.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
        k32.OpenProcess.restype = ctypes.c_void_p

        # CloseHandle(HANDLE) -> BOOL
        k32.CloseHandle.argtypes = [ctypes.c_void_p]
        k32.CloseHandle.restype = ctypes.c_int

        # GlobalMemoryStatusEx(LPMEMORYSTATUSEX) -> BOOL
        k32.GlobalMemoryStatusEx.argtypes = [ctypes.c_void_p]
        k32.GlobalMemoryStatusEx.restype = ctypes.c_int
    except Exception:
        pass


def should_use_color(is_interactive=True):
    """Determine whether color output should be enabled based on terminal and flags."""
    if "NO_COLOR" in os.environ or os.environ.get("TERM", "").lower() == "dumb":
        return False
    if not sys.stdout.isatty():
        return False
    return is_interactive


