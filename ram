# ANSI is enabled only for an interactive terminal unless explicitly disabled.
USE_COLOR = (
    sys.stdout.isatty()
    and "NO_COLOR" not in os.environ
    and os.environ.get("TERM", "").lower() != "dumb"
)

if USE_COLOR:
    C_RESET = "\033[0m"
    C_BOLD = "\033[1m"
    C_DIM = "\033[2m"
    C_CYAN = "\033[38;2;80;200;220m"
    C_BLUE = "\033[38;2;100;160;255m"
    C_GREEN = "\033[38;2;75;210;110m"
    C_YELLOW = "\033[38;2;240;200;80m"
    C_RED = "\033[38;2;240;90;90m"
    C_GRAY = "\033[38;2;140;145;155m"
    C_DARK_GRAY = "\033[38;2;65;70;80m"
    C_WHITE = "\033[38;2;235;240;245m"
else:
    C_RESET = C_BOLD = C_DIM = ""
    C_CYAN = C_BLUE = C_GREEN = C_YELLOW = C_RED = C_GRAY = C_DARK_GRAY = C_WHITE = ""

BLOCK_FULL = "█"
BLOCK_TRACK = "░"
BLOCK_BORDER_L = "["
BLOCK_BORDER_R = "]"

try:
    PAGE_SIZE = int(os.sysconf("SC_PAGE_SIZE"))
except (AttributeError, OSError, ValueError):
    PAGE_SIZE = 4096

PID_NAME_CACHE = {}


def format_bytes(value, precision=2):
    """Return a non-negative byte count in a compact IEC unit."""
    try:
        value = max(0, int(value))
    except (TypeError, ValueError):
        value = 0

    if value < 1024:
        return "{} B".format(value)
    if value < 1024 ** 2:
        return "{:.{}f} KB".format(value / 1024.0, precision)
    if value < 1024 ** 3:
        return "{:.{}f} MB".format(value / (1024.0 ** 2), precision)
    if value < 1024 ** 4:
        return "{:.{}f} GB".format(value / (1024.0 ** 3), precision)
    return "{:.{}f} TB".format(value / (1024.0 ** 4), precision)


def clamp(value, low, high):
    return max(low, min(high, value))


def percentage(part, whole):
    """Return a bounded percentage; zero is used when the denominator is unknown."""
    try:
        if whole <= 0:
            return 0.0
        return clamp((float(part) / float(whole)) * 100.0, 0.0, 100.0)
    except (TypeError, ValueError, ZeroDivisionError):
        return 0.0


def sanitize_text(value, replacement="~"):
    """Remove terminal control characters from untrusted process names."""
    if value is None:
        return ""
    text = str(value)
    cleaned = []
    for char in text:
        code = ord(char)
        if char in ("\n", "\r", "\t") or code < 32 or code == 127 or 0x80 <= code <= 0x9F:
            cleaned.append(replacement if char not in ("\t",) else " ")
        else:
            cleaned.append(char)
    return "".join(cleaned).strip()


def normalize_process(name, pid, rss):
    name = sanitize_text(name) or "unknown"
    try:
        pid_int = int(pid)
    except (TypeError, ValueError):
        pid_int = 0
    try:
        rss_int = max(0, int(rss))
    except (TypeError, ValueError):
        rss_int = 0
    return {
        "pid": pid_int,
        "name": name,
        "rss": rss_int,
        "count": 1,
    }


def aggregate_processes(rows, group_by_name=True):
    """Aggregate process records and sort deterministically by RSS then name/PID."""
    groups = {}
    for row in rows:
        if not row:
            continue
        name = sanitize_text(row.get("name")) or "unknown"
        pid = int(row.get("pid", 0) or 0)
        rss = max(0, int(row.get("rss", 0) or 0))

        if group_by_name:
            key = name
            if key not in groups:
                groups[key] = {"name": name, "rss": 0, "count": 0}
            groups[key]["rss"] += rss
            groups[key]["count"] += 1
        else:
            key = pid
            groups[key] = {
                "name": "{} [{}]".format(name, pid),
                "rss": rss,
                "count": 1,
                "pid": pid,
            }

    result = list(groups.values())
    return sorted(
        result,
        key=lambda item: (
            -int(item.get("rss", 0)),
            sanitize_text(item.get("name", "")).casefold(),
            int(item.get("pid", 0) or 0),
        ),
    )


def _memory_snapshot(**values):
    defaults = {
        "total": 0,
        "available": 0,
        "used": 0,
        "commit_as": 0,
        "commit_limit": 0,
        "cached": 0,
        "swap_used": 0,
        "swap_total": 0,
        "swap_desc": "unknown",
        "valid": True,
    }
    defaults.update(values)

    total = max(0, int(defaults["total"] or 0))
    available = clamp(int(defaults["available"] or 0), 0, total) if total else 0
    used = clamp(int(defaults["used"] or 0), 0, total) if total else 0
    defaults["total"] = total
    defaults["available"] = available
    defaults["used"] = used
    defaults["commit_as"] = max(0, int(defaults["commit_as"] or 0))
    defaults["commit_limit"] = max(0, int(defaults["commit_limit"] or 0))
    defaults["cached"] = max(0, int(defaults["cached"] or 0))
    defaults["swap_used"] = max(0, int(defaults["swap_used"] or 0))
    defaults["swap_total"] = max(0, int(defaults["swap_total"] or 0))
    defaults["swap_desc"] = sanitize_text(defaults.get("swap_desc")) or "unknown"
    defaults["valid"] = bool(defaults["valid"])
    return defaults


def parse_linux_meminfo(text):
    """Parse /proc/meminfo content without assuming every kernel field exists."""
    info = {}
    for line in text.splitlines():
        if ":" not in line:
            continue
        key, raw = line.split(":", 1)
        fields = raw.strip().split()
        if not fields:
            continue
        try:
            value = int(fields[0])
        except ValueError:
            continue

        unit = fields[1].lower() if len(fields) > 1 else ""
        if unit in ("kb", "kib"):
            value *= 1024
        elif unit in ("mb", "mib"):
            value *= 1024 ** 2
        elif unit in ("gb", "gib"):
            value *= 1024 ** 3
        info[key.strip()] = value
    return info


def _read_text(path):
    with open(path, "r") as handle:
        return handle.read()


def get_meminfo_linux():
    """Collect Linux memory data from /proc, with explicit best-effort semantics."""
    try:
        info = parse_linux_meminfo(_read_text("/proc/meminfo"))
    except (OSError, IOError):
        return _memory_snapshot(valid=False, swap_desc="unavailable")

    total = info.get("MemTotal", 0)
    if total <= 0:
        return _memory_snapshot(valid=False, swap_desc="unavailable")

    available = info.get("MemAvailable", info.get("MemFree", 0))
    used = max(0, total - available)

    # Cached is deliberately an estimate: Linux documents that several
    # /proc/meminfo counters overlap and do not necessarily add to total RAM.
    cached = (
        info.get("Cached", 0)
        + info.get("SReclaimable", 0)
        + info.get("Buffers", 0)
    )

    swap_total = info.get("SwapTotal", 0)
    swap_free = info.get("SwapFree", 0)
    swap_used = max(0, swap_total - swap_free)

    has_zram = False
    has_disk = False
    try:
        swap_text = _read_text("/proc/swaps")
        for line in swap_text.splitlines()[1:]:
            fields = line.split()
            if not fields:
                continue
            if "zram" in os.path.basename(fields[0]).lower():
                has_zram = True
            else:
                has_disk = True
    except (OSError, IOError):
        pass

    if has_zram and has_disk:
        swap_desc = "zram + disk swap"
    elif has_zram:
        swap_desc = "zram swap"
    elif has_disk:
        swap_desc = "disk swap"
    elif swap_total:
        swap_desc = "swap present (type unavailable)"
    else:
        swap_desc = "no active swap"

    return _memory_snapshot(
        total=total,
        available=available,
        used=used,
        commit_as=info.get("Committed_AS", 0),
        commit_limit=info.get("CommitLimit", 0),
        cached=cached,
        swap_used=swap_used,
        swap_total=swap_total,
        swap_desc=swap_desc,
    )


class MEMORYSTATUSEX(ctypes.Structure):
    _fields_ = [
        ("dwLength", ctypes.c_ulong),
        ("dwMemoryLoad", ctypes.c_ulong),
        ("ullTotalPhys", ctypes.c_ulonglong),
        ("ullAvailPhys", ctypes.c_ulonglong),
        ("ullTotalPageFile", ctypes.c_ulonglong),
        ("ullAvailPageFile", ctypes.c_ulonglong),
        ("ullTotalVirtual", ctypes.c_ulonglong),
        ("ullAvailVirtual", ctypes.c_ulonglong),
        ("ullAvailExtendedVirtual", ctypes.c_ulonglong),
    ]


def get_meminfo_windows():
    """Collect Windows physical memory and commit-limit information."""
    try:
        kernel32 = ctypes.windll.kernel32
        stat = MEMORYSTATUSEX()
        stat.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
        if not kernel32.GlobalMemoryStatusEx(ctypes.byref(stat)):
            raise ctypes.WinError()

        total = int(stat.ullTotalPhys)
        available = int(stat.ullAvailPhys)
        used = max(0, total - available)

        # Windows' total page-file field includes physical RAM. Therefore
        # totalPageFile - totalPhys is only the configured paging capacity.
        pagefile_total = max(0, int(stat.ullTotalPageFile) - total)
        commit_as = max(0, int(stat.ullTotalPageFile) - int(stat.ullAvailPageFile))
        commit_limit = int(stat.ullTotalPageFile)

        # GlobalMemoryStatusEx does not expose actual pagefile residency.
        # Do not fabricate a "pagefile used" value from commit - physical used.
        return _memory_snapshot(
            total=total,
            available=available,
            used=used,
            commit_as=commit_as,
            commit_limit=commit_limit,
            cached=0,
            swap_used=0,
            swap_total=pagefile_total,
            swap_desc="pagefile capacity (usage unavailable)",
        )
    except (AttributeError, OSError, ctypes.error):
        return _memory_snapshot(valid=False, swap_desc="unavailable")


def _parse_macos_size(value):
    match = re.match(r"^\s*([0-9]+(?:\.[0-9]+)?)\s*([KMGTP]?)B?\s*$", value, re.I)
    if not match:
        return 0
    number = float(match.group(1))
    unit = match.group(2).upper()
    multipliers = {
        "": 1,
        "K": 1024,
        "M": 1024 ** 2,
        "G": 1024 ** 3,
        "T": 1024 ** 4,
        "P": 1024 ** 5,
    }
    return int(number * multipliers[unit])


def _run_command(args):
    # No shell is used; arguments are passed directly to the executable.
    return subprocess.check_output(
        args,
        universal_newlines=True,
        stderr=subprocess.DEVNULL,
    )


def get_meminfo_darwin():
    """Collect macOS memory statistics using Apple's standard system tools."""
    try:
        total = int(_run_command(["sysctl", "-n", "hw.memsize"]).strip())
        vm_out = _run_command(["vm_stat"])

        page_size = 4096
        pages = {}
        for line in vm_out.splitlines():
            if "page size of" in line:
                match = re.search(r"(\d+)\s*bytes", line)
                if match:
                    page_size = int(match.group(1))
                continue
            if ":" not in line:
                continue
            key, raw = line.split(":", 1)
            digits = re.sub(r"[^\d]", "", raw)
            if digits:
                pages[key.strip()] = int(digits)

        free = pages.get("Pages free", 0)
        inactive = pages.get("Pages inactive", 0)
        speculative = pages.get("Pages speculative", 0)
        available = min(total, (free + inactive + speculative) * page_size)

        # macOS does not expose Linux-style "used" and "available" semantics.
        # This is a best-effort approximation from vm_stat.
        used = max(0, total - available)

        cached = (inactive + speculative) * page_size

        swap_used = 0
        swap_total = 0
        try:
            swap_text = _run_command(["sysctl", "-n", "vm.swapusage"])
            for key, value, unit in re.findall(
                r"(\w+)\s*=\s*([0-9.]+)\s*([KMGTP]?)",
                swap_text,
                re.I,
            ):
                size = _parse_macos_size("{}{}".format(value, unit))
                if key.lower() == "total":
                    swap_total = size
                elif key.lower() == "used":
                    swap_used = size
        except (OSError, IOError):
            pass

        return _memory_snapshot(
            total=total,
            available=available,
            used=used,
            commit_as=used + swap_used,
            commit_limit=total + swap_total,
            cached=cached,
            swap_used=swap_used,
            swap_total=swap_total,
            swap_desc="compressed RAM + disk swap",
        )
    except (OSError, IOError, ValueError, subprocess.CalledProcessError, subprocess.SubprocessError):
        return _memory_snapshot(valid=False, swap_desc="unavailable")



def get_meminfo():
    if SYSTEM_OS == "Linux":
        return get_meminfo_linux()
    if SYSTEM_OS == "Windows":
        return get_meminfo_windows()
    if SYSTEM_OS == "Darwin":
        return get_meminfo_darwin()
    return _memory_snapshot(valid=False, swap_desc="unsupported OS")


def _linux_processes():
    rows = []
    try:
        pids = [name for name in os.listdir("/proc") if name.isdigit()]
    except OSError:
        return rows

    current = set(pids)
    stale = [pid for pid in PID_NAME_CACHE if pid not in current]
    for pid in stale:
        PID_NAME_CACHE.pop(pid, None)

    for pid in pids:
        try:
            with open("/proc/{}/statm".format(pid), "r") as handle:
                fields = handle.read().split()
            if len(fields) < 2:
                continue
            rss = int(fields[1]) * PAGE_SIZE
            if rss <= 0:
                continue

            name = PID_NAME_CACHE.get(pid)
            if not name:
                try:
                    name = _read_text("/proc/{}/comm".format(pid)).strip()
                except (OSError, IOError):
                    name = None

                if not name:
                    try:
                        with open("/proc/{}/cmdline".format(pid), "rb") as handle:
                            raw = handle.read().decode("utf-8", "replace")
                        command = raw.replace("\x00", " ").strip()
                        if command:
                            name = os.path.basename(command.split()[0])
                    except (OSError, IOError):
                        name = None

                PID_NAME_CACHE[pid] = sanitize_text(name) or "PID {}".format(pid)

            rows.append(normalize_process(name, pid, rss))
        except (OSError, IOError, ValueError, OverflowError):
            continue
    return rows


def _windows_processes():
    """Enumerate Windows processes without invoking tasklist or a shell."""
    rows = []
    try:
        kernel32 = ctypes.windll.kernel32
        psapi = ctypes.windll.psapi

        TH32CS_SNAPPROCESS = 0x00000002
        PROCESS_QUERY_INFORMATION = 0x0400
        PROCESS_VM_READ = 0x0010
        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value

        class PROCESSENTRY32W(ctypes.Structure):
            _fields_ = [
                ("dwSize", ctypes.c_ulong),
                ("cntUsage", ctypes.c_ulong),
                ("th32ProcessID", ctypes.c_ulong),
                ("th32DefaultHeapID", ctypes.POINTER(ctypes.c_ulong)),
                ("th32ModuleID", ctypes.c_ulong),
                ("cntThreads", ctypes.c_ulong),
                ("th32ParentProcessID", ctypes.c_ulong),
                ("pcPriClassBase", ctypes.c_long),
                ("dwFlags", ctypes.c_ulong),
                ("szExeFile", ctypes.c_wchar * 260),
            ]

        class PROCESS_MEMORY_COUNTERS(ctypes.Structure):
            _fields_ = [
                ("cb", ctypes.c_ulong),
                ("PageFaultCount", ctypes.c_ulong),
                ("PeakWorkingSetSize", ctypes.c_size_t),
                ("WorkingSetSize", ctypes.c_size_t),
                ("QuotaPeakPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t),
                ("QuotaNonPagedPoolUsage", ctypes.c_size_t),
                ("PagefileUsage", ctypes.c_size_t),
                ("PeakPagefileUsage", ctypes.c_size_t),
            ]

        kernel32.CreateToolhelp32Snapshot.argtypes = [ctypes.c_ulong, ctypes.c_ulong]
        kernel32.CreateToolhelp32Snapshot.restype = ctypes.c_void_p
        kernel32.Process32FirstW.argtypes = [ctypes.c_void_p, ctypes.POINTER(PROCESSENTRY32W)]
        kernel32.Process32FirstW.restype = ctypes.c_int
        kernel32.Process32NextW.argtypes = [ctypes.c_void_p, ctypes.POINTER(PROCESSENTRY32W)]
        kernel32.Process32NextW.restype = ctypes.c_int
        kernel32.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
        kernel32.OpenProcess.restype = ctypes.c_void_p
        kernel32.CloseHandle.argtypes = [ctypes.c_void_p]
        kernel32.CloseHandle.restype = ctypes.c_int

        try:
            psapi.GetProcessMemoryInfo.argtypes = [
                ctypes.c_void_p,
                ctypes.POINTER(PROCESS_MEMORY_COUNTERS),
                ctypes.c_ulong,
            ]
            psapi.GetProcessMemoryInfo.restype = ctypes.c_int
        except AttributeError:
            return rows

        snapshot = kernel32.CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0)
        if not snapshot or snapshot == INVALID_HANDLE_VALUE:
            return rows

        try:
            entry = PROCESSENTRY32W()
            entry.dwSize = ctypes.sizeof(entry)
            ok = kernel32.Process32FirstW(snapshot, ctypes.byref(entry))
            while ok:
                pid = int(entry.th32ProcessID)
                name = sanitize_text(entry.szExeFile) or "unknown"
                handle = kernel32.OpenProcess(
                    PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ,
                    0,
                    pid,
                )
                if not handle:
                    handle = kernel32.OpenProcess(
                        PROCESS_QUERY_INFORMATION | PROCESS_VM_READ,
                        0,
                        pid,
                    )

                if handle:
                    try:
                        counters = PROCESS_MEMORY_COUNTERS()
                        counters.cb = ctypes.sizeof(counters)
                        if psapi.GetProcessMemoryInfo(
                            handle, ctypes.byref(counters), counters.cb
                        ):
                            rows.append(
                                normalize_process(name, pid, int(counters.WorkingSetSize))
                            )
                    finally:
                        kernel32.CloseHandle(handle)

                ok = kernel32.Process32NextW(snapshot, ctypes.byref(entry))
        finally:
            kernel32.CloseHandle(snapshot)
    except (AttributeError, OSError, ValueError, TypeError, ctypes.error):
        return rows
    return rows


def _darwin_processes():
    """Use sysctl KERN_PROC on macOS to avoid spawning ps once per refresh."""
    # The packed kinfo_proc layout differs between macOS architectures and
    # releases; using ps here is safer than guessing an ABI layout.
    try:
        output = _run_command(["ps", "-axo", "pid,rss,comm"])
    except (OSError, IOError, ValueError, subprocess.CalledProcessError, subprocess.SubprocessError):
        return []

    rows = []
    for line in output.splitlines()[1:]:
        parts = line.strip().split(maxsplit=2)
        if len(parts) != 3 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        try:
            pid = int(parts[0])
            rss = int(parts[1]) * 1024
        except ValueError:
            continue
        name = os.path.basename(parts[2])
        rows.append(normalize_process(name, pid, rss))
    return rows


def get_processes(group_by_name=True):
    if SYSTEM_OS == "Linux":
        rows = _linux_processes()
    elif SYSTEM_OS == "Windows":
        rows = _windows_processes()
    elif SYSTEM_OS == "Darwin":
        rows = _darwin_processes()
    else:
        rows = []
    return aggregate_processes(rows, group_by_name)


class TerminalManager:
    """Small terminal-state manager with safe cleanup and non-blocking input."""
    def __init__(self):
        self.is_tty = bool(sys.stdout.isatty() and sys.stdin.isatty())
        self.orig_termios = None
        self.fd = None
        self.raw_enabled = False

        if self.is_tty:
            try:
                self.fd = sys.stdin.fileno()
            except (OSError, IOError, ValueError):
                self.is_tty = False

        if SYSTEM_OS != "Windows" and self.is_tty:
            try:
                import termios
                self.orig_termios = termios.tcgetattr(self.fd)
            except (ImportError, OSError, IOError):
                self.orig_termios = None

    def setup_raw(self):
        if not self.is_tty:
            return
        if SYSTEM_OS != "Windows" and self.orig_termios is not None:
            try:
                import tty
                tty.setcbreak(self.fd)
                self.raw_enabled = True
            except (ImportError, OSError, IOError):
                pass
        try:
            sys.stdout.write("\033[?25l")
            sys.stdout.flush()
        except (OSError, IOError):
            pass

    def restore(self):
        if not self.is_tty:
            return
        if SYSTEM_OS != "Windows" and self.orig_termios is not None:
            try:
                import termios
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.orig_termios)
            except (ImportError, OSError, IOError):
                pass
        try:
            sys.stdout.write("\033[?25h{}".format(C_RESET))
            sys.stdout.flush()
        except (OSError, IOError):
            pass
        self.raw_enabled = False

    def check_key(self):
        if not self.is_tty:
            return None
        if SYSTEM_OS == "Windows":
            try:
                import msvcrt
                if not msvcrt.kbhit():
                    return None
                ch = msvcrt.getwch()
                if ch in ("\x00", "\xe0"):
                    # Consume the second byte of an extended key sequence.
                    if msvcrt.kbhit():
                        msvcrt.getwch()
                    return None
                return ch
            except (ImportError, OSError):
                return None

        try:
            readable, _, _ = select.select([self.fd], [], [], 0)
            if readable:
                return os.read(self.fd, 1).decode("utf-8", "ignore")
        except (OSError, IOError, ValueError):
            return None
        return None


def render_bar(ratio, width=42):
    ratio = clamp(float(ratio), 0.0, 1.0)
    width = max(1, int(width))
    filled = int(round(width * ratio))
    empty = width - filled

    if ratio < 0.60:
        fill_color = C_GREEN
    elif ratio < 0.85:
        fill_color = C_YELLOW
    else:
        fill_color = C_RED

    return (
        "{}{}{}{}{}{}{}{}".format(
            C_GRAY, BLOCK_BORDER_L, C_RESET,
            fill_color, BLOCK_FULL * filled, C_RESET,
            C_DARK_GRAY + BLOCK_TRACK * empty + C_RESET,
            C_GRAY + BLOCK_BORDER_R + C_RESET,
        )
    )


def render_mini_bar(ratio, width=16):
    ratio = clamp(float(ratio), 0.0, 1.0)
    width = max(1, int(width))
    filled = int(round(width * ratio))
    return "{}{}{}{}".format(
        C_GREEN, BLOCK_FULL * filled, C_RESET,
        C_DARK_GRAY + BLOCK_TRACK * (width - filled) + C_RESET,
    )


def terminal_width(default=80):
    try:
        return max(20, int(os.get_terminal_size().columns))
    except (OSError, IOError, AttributeError):
        try:
            return max(20, int(os.environ.get("COLUMNS", default)))
        except (TypeError, ValueError):
            return default


def build_snapshot(group_procs=True, proc_count=8):
    mem = get_meminfo()
    processes = get_processes(group_procs)[:proc_count]
    return {
        "timestamp": datetime.now().astimezone().isoformat(),
        "hostname": socket.gethostname(),
        "os": SYSTEM_OS,
        "version": __version__,
        "memory": mem,
        "top_processes": processes,
    }


def render_snapshot(snapshot, paused=False):
    mem = snapshot["memory"]
    total = int(mem.get("total", 0))
    used = int(mem.get("used", 0))
    available = int(mem.get("available", 0))
    commit_as = int(mem.get("commit_as", 0))
    commit_limit = int(mem.get("commit_limit", 0))
    cached = int(mem.get("cached", 0))
    swap_used = int(mem.get("swap_used", 0))
    swap_total = int(mem.get("swap_total", 0))
    processes = snapshot["top_processes"]

    used_pct = percentage(used, total)
    commit_pct = percentage(commit_as, commit_limit)
    proc_sum = sum(int(item.get("rss", 0)) for item in processes)
    proc_pct = percentage(proc_sum, total)

    cols = terminal_width()
    bar_width = clamp(cols - 20, 20, 42)
    hostname = sanitize_text(snapshot.get("hostname")) or "unknown"
    now_str = datetime.now().strftime("%a %H:%M:%S")

    lines = [
        "{}{}RAM USAGE{} {}—{} {}{}{}  {}{}{}".format(
            C_CYAN, C_BOLD, C_RESET, C_GRAY, C_RESET,
            C_WHITE, hostname, C_RESET, C_GRAY, now_str, C_RESET
        )
    ]
    if paused:
        lines[0] += "  {}[PAUSED]{}".format(C_YELLOW, C_RESET)

    lines.append("{} {}".format(render_bar(used_pct / 100.0, bar_width), "{:.1f}%".format(used_pct)))
    lines.append("")

    lines.append(
        "{}{}Used{}    {}{:<10}{} {}{}Available{}  {}{:<10}{} {}{}Total{}   {}{}".format(
            C_WHITE, C_BOLD, C_RESET, C_GREEN, format_bytes(used), C_RESET,
            C_WHITE, C_BOLD, C_RESET, C_GREEN, format_bytes(available), C_RESET,
            C_WHITE, C_BOLD, C_RESET, C_WHITE, format_bytes(total),
        ) + C_RESET
    )
    lines.append(
        "{}{}Commit{}  {} / {}  {}({:.0f}% of commit limit){}".format(
            C_WHITE, C_BOLD, C_RESET,
            format_bytes(commit_as), format_bytes(commit_limit),
            C_GRAY, commit_pct, C_RESET,
        )
    )
    if cached > 0 or SYSTEM_OS == "Linux":
        lines.append(
            "{}{}Cached{}  {:<10} {}(cache + reclaimable estimate){}".format(
                C_WHITE, C_BOLD, C_RESET, format_bytes(cached), C_GRAY, C_RESET
            )
        )
    lines.append(
        "{}{}Swap{}    {} / {}   {}({}){}".format(
            C_WHITE, C_BOLD, C_RESET,
            format_bytes(swap_used), format_bytes(swap_total),
            C_GRAY, mem.get("swap_desc", "unknown"), C_RESET,
        )
    )
    lines.append("")

    grouped = True
    if processes and "count" in processes[0]:
        grouped = not any("pid" in item for item in processes)
    mode = "RESIDENT SET" if grouped else "PROCESS PID"
    lines.append(
        "{}{}TOP {} PROCESSES BY {}{}".format(
            C_CYAN, C_BOLD, len(processes), mode, C_RESET
        )
    )

    max_rss = max([int(item.get("rss", 0)) for item in processes] or [1])
    for item in processes:
        count = int(item.get("count", 1) or 1)
        count_text = " ({})".format(count) if grouped and count > 1 else ""
        name = sanitize_text(item.get("name")) or "unknown"
        full_name = name + count_text
        if len(full_name) > 19:
            full_name = full_name[:18] + "~"
        name_display = full_name.ljust(19)

        rss = int(item.get("rss", 0) or 0)
        lines.append(
            "{}{}{} {}{}{}  {}  {}{:>4.1f}%{}".format(
                C_WHITE, name_display, C_RESET,
                C_GREEN, format_bytes(rss, 1).rjust(9), C_RESET,
                render_mini_bar(rss / float(max_rss), 16),
                C_GRAY, percentage(rss, total), C_RESET,
            )
        )

    lines.append("")
    lines.append(
        "{}These {} account for  {}{}{} ({:.0f}% of installed RAM){}".format(
            C_GRAY, len(processes), C_WHITE, format_bytes(proc_sum),
            C_RESET, proc_pct, C_RESET
        )
    )
    if not mem.get("valid", True):
        lines.append("{}Warning: memory metrics are unavailable.{}".format(C_YELLOW, C_RESET))

    return "\n".join(lines)


def validate_args(args):
    if args.rate < 20 or args.rate > 2000:
        raise ValueError("refresh rate must be between 20 and 2000 ms")
    if args.count < 1 or args.count > 10000:
        raise ValueError("process count must be between 1 and 10000")


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog="ram",
        description="ram-tui v{} - real-time terminal memory monitor".format(__version__),
    )
    parser.add_argument(
        "-r", "--rate", type=int, default=100,
        help="refresh interval in milliseconds (20-2000, default: 100)",
    )
    parser.add_argument(
        "-n", "--count", type=int, default=8,
        help="number of top processes to display (1-10000, default: 8)",
    )
    parser.add_argument("-1", "--once", action="store_true", help="output one snapshot and exit")
    parser.add_argument("--json", action="store_true", help="output one machine-readable JSON snapshot and exit")
    parser.add_argument("--no-group", action="store_true", help="show individual process PIDs instead of grouping")
    parser.add_argument("-v", "--version", action="version", version="%(prog)s v{}".format(__version__))
    args = parser.parse_args(argv)
    try:
        validate_args(args)
    except ValueError as exc:
        parser.error(str(exc))
    return args


def main(argv=None):
    args = parse_args(argv)
    group_procs = not args.no_group

    if args.json:
        snapshot = build_snapshot(group_procs, args.count)
        json.dump(snapshot, sys.stdout, indent=2, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0

    if args.once:
        snapshot = build_snapshot(group_procs, args.count)
        sys.stdout.write(render_snapshot(snapshot) + "\n")
        return 0

    term = TerminalManager()
    refresh_seconds = args.rate / 1000.0
    paused = False
    first_render = True
    next_refresh = time.monotonic()

    def stop_handler(signum=None, frame=None):
        raise KeyboardInterrupt

    try:
        signal.signal(signal.SIGINT, stop_handler)
        if hasattr(signal, "SIGTERM"):
            signal.signal(signal.SIGTERM, stop_handler)
    except (ValueError, OSError):
        pass

    try:
        term.setup_raw()
        while True:
            now = time.monotonic()
            if now < next_refresh:
                # Poll input at short intervals so pause/quit stays responsive.
                time.sleep(min(0.02, next_refresh - now))
            else:
                if term.is_tty:
                    ch = term.check_key()
                    if ch:
                        if ch in ("q", "Q", "\x03"):
                            break
                        if ch in ("p", "P", " "):
                            paused = not paused
                        elif ch in ("+", "="):
                            args.rate = max(20, args.rate - 25)
                            refresh_seconds = args.rate / 1000.0
                        elif ch in ("-", "_"):
                            args.rate = min(2000, args.rate + 50)
                            refresh_seconds = args.rate / 1000.0
                        elif ch == "1":
                            group_procs = True
                        elif ch == "2":
                            group_procs = False

                if not paused or first_render:
                    snapshot = build_snapshot(group_procs, args.count)
                    output = render_snapshot(snapshot, paused=paused)
                    if term.is_tty:
                        sys.stdout.write("\033[H\033[2J" + output + "\n")
                    else:
                        sys.stdout.write(output + "\n")
                    sys.stdout.flush()
                    first_render = False

                # Monotonic scheduling avoids drift caused by collection/render time.
                next_refresh = max(next_refresh + refresh_seconds, time.monotonic())

    except KeyboardInterrupt:
        return 0
    except (BrokenPipeError, OSError):
        return 0
    finally:
        term.restore()

    return 0


if __name__ == "__main__":
    sys.exit(main())
