def render_smooth_bar(ratio, width=32, pal=None):
    """Renders high-resolution smooth fractional progress bar with sub-character accuracy."""
    pal = pal or get_palette("monochrome", False)
    ratio = clamp(ratio, 0.0, 1.0)
    total_eighths = int(round(ratio * width * 8))
    full_blocks = total_eighths // 8
    rem_eighths = total_eighths % 8
    empty_blocks = max(0, width - full_blocks - (1 if rem_eighths > 0 else 0))

    if ratio < 0.60:
        c = pal["GOOD"]
    elif ratio < 0.85:
        c = pal["WARNING"]
    else:
        c = pal["CRITICAL"]

    filled_part = f"{c}{BLOCK_FULL * full_blocks}{FRACTIONAL_BLOCKS[rem_eighths]}{pal['RESET']}"
    empty_part = f"{pal['TRACK']}{BLOCK_TRACK * empty_blocks}{pal['RESET']}"
    return f"{filled_part}{empty_part}"


def visible_len(s):
    """Printable width of a string, ignoring ANSI escape codes (for alignment math)."""
    return len(ANSI_ESCAPE_RE.sub("", s))


def render_snapshot(mem, procs, group_procs=True, paused=False, mode="hero", theme="default", enable_color=True, show_help=False):
    """Renders a clean, breathable, modern dashboard across all display modes."""
    pal = get_palette(theme, enable_color)
    hostname = sanitize_text(socket.gethostname())
    now_str = datetime.now().strftime("%H:%M:%S")

    total = mem.get("total", 0)
    available = mem.get("available", 0)
    used = mem.get("used", 0)
    used_pct = percentage(used, total)

    cols = shutil.get_terminal_size((80, 24)).columns

    r = pal["RESET"]
    t = pal["TEXT"]
    h = pal["HEADER"]
    a = pal["ACCENT"]
    g = pal["GOOD"]
    w = pal["WARNING"]
    crit = pal["CRITICAL"]
    m = pal["MUTED"]
    dim = pal["DIM"]
    bold = pal["BOLD"]

    # 1. TINY MODE (Single line for Waybar / tmux / status bars)
    if mode == "tiny":
        used_str = format_bytes(used, precision=1)
        total_str = format_bytes(total, precision=1)
        res = f"RAM: {used_str} / {total_str} ({used_pct:.1f}%)"
        if show_help:
            res += f"\n{m}q quit   p pause   t theme   m mode{r}"
        return res

    # 2. MINI MODE (Clean single-line meter)
    if mode == "mini":
        bar_w = clamp(cols - 32, 10, 44)
        smooth_bar = render_smooth_bar(used / total if total > 0 else 0, width=bar_w, pal=pal)
        pct_color = g if used_pct < 60 else (w if used_pct < 85 else crit)
        res = f"{h}{bold}RAM{r}  {smooth_bar}  {pct_color}{bold}{used_pct:>5.1f}%{r}  {t}{format_bytes(used, 1)}{r}{m} / {r}{t}{format_bytes(total, 1)}{r}"
        if show_help:
            res += f"\n{m}{dim}q quit   p pause   t theme   m mode   +/- rate{r}"
        return res

    # 3. HERO & COMPACT MODES
    lines = []
    rule_w = clamp(cols, 24, 96)
    rule = f"{m}{dim}{'─' * rule_w}{r}"

    state_str = f"  {w}{bold}paused{r}" if paused else ""
    header_left = (
        f"{h}{bold}RAM{r}  {m}·{r}  {t}{hostname}{r}  {m}·{r}  "
        f"{m}{SYSTEM_OS} {platform.machine()}{r}  {m}·{r}  {a}{theme}{r}{state_str}"
    )
    clock = f"{m}{now_str}{r}"
    gap = max(2, rule_w - visible_len(header_left) - visible_len(clock))
    lines.append(f"{header_left}{' ' * gap}{clock}")
    lines.append(rule)
    lines.append("")

    # Hero usage bar
    bar_width = clamp(cols - 24, 16, 64)
    smooth_bar = render_smooth_bar(used / total if total > 0 else 0, width=bar_width, pal=pal)
    pct_color = g if used_pct < 60 else (w if used_pct < 85 else crit)
    lines.append(smooth_bar)
    lines.append(f"{pct_color}{bold}{used_pct:>5.1f}%{r}  {t}{bold}{format_bytes(used, 2)}{r}{m} used of {r}{t}{format_bytes(total, 2)}{r}")
    lines.append("")

    # Clean Unboxed Metrics Breakdown Grid
    commit_str = f"{format_bytes(mem.get('commit_as') or 0, 1)}/{format_bytes(mem.get('commit_limit') or total, 1)}" if mem.get("commit_as") is not None else "N/A"
    cached_str = format_bytes(mem.get("cached", 0), 1) if mem.get("cached") is not None else "N/A"
    swap_str = f"{format_bytes(mem.get('swap_used') or 0, 1)} ({mem.get('swap_desc', '')})"

    if cols >= 68:
        # 6-column single-line grid on wide terminals
        lines.append(f"{m}USED          AVAILABLE     TOTAL         COMMIT              CACHED        SWAP{r}")
        lines.append(f"{g}{bold}{format_bytes(used, 2):<14}{r}{t}{bold}{format_bytes(available, 2):<14}{r}{t}{bold}{format_bytes(total, 2):<14}{r}{t}{commit_str:<20}{r}{t}{cached_str:<14}{r}{t}{swap_str}{r}")
    elif cols >= 50:
        # 3-column wrapped grid on medium terminals
        lines.append(f"{m}USED          AVAILABLE     TOTAL{r}")
        lines.append(f"{g}{bold}{format_bytes(used, 2):<14}{r}{t}{bold}{format_bytes(available, 2):<14}{r}{t}{bold}{format_bytes(total, 2):<14}{r}")
        lines.append(f"{m}COMMIT              CACHED        SWAP{r}")
        lines.append(f"{t}{commit_str:<20}{r}{t}{cached_str:<14}{r}{t}{swap_str}{r}")
    else:
        # Stacked single-column readout for very narrow panes (tmux splits, etc.)
        for label, value, color in (
            ("USED", format_bytes(used, 2), g),
            ("AVAILABLE", format_bytes(available, 2), t),
            ("TOTAL", format_bytes(total, 2), t),
            ("COMMIT", commit_str, t),
            ("CACHED", cached_str, t),
            ("SWAP", swap_str, t),
        ):
            lines.append(f"{m}{label:<11}{r}{color}{bold}{value}{r}")

    # 4. PROCESS RANKING (Only in HERO mode)
    if mode == "hero" and procs:
        lines.append("")
        lines.append(rule)
        lines.append("")
        mode_label = "RESIDENT SET" if group_procs else "PID"
        lines.append(f"{m}PROCESS ({mode_label}){r}        {m}RSS{r}        {m}USAGE{r}                {m}SHARE{r}")

        max_p_rss = procs[0]["rss"] if procs else 1
        name_width = clamp(cols - 48, 10, 22)
        p_bar_w = clamp(cols - 46, 6, 20)

        for p in procs:
            count_str = f" ({p['count']})" if p.get("count", 1) > 1 else ""
            name_full = f"{p['name']}{count_str}"
            name_disp = (name_full[:name_width - 1] + "~") if len(name_full) > name_width else name_full.ljust(name_width)

            rss_str = format_bytes(p["rss"], precision=1).rjust(8)
            p_pct = percentage(p["rss"], total)
            p_bar = render_smooth_bar(p["rss"] / max_p_rss if max_p_rss > 0 else 0, width=p_bar_w, pal=pal)

            lines.append(f"{t}{name_disp}{r}   {g}{rss_str}{r}   {p_bar}   {m}{p_pct:>4.1f}%{r}")

    # Quiet footer
    lines.append("")
    lines.append(rule)
    lines.append(f"{m}{dim}q quit   p pause   t theme   m mode   1/2 group   +/- rate{r}")

    return "\n".join(lines)


