def render_bar(ratio, width=42, colors=None):
    """Renders usage bar with dynamic width and color scaling."""
    colors = colors or get_ansi_palette(False)
    ratio = clamp(ratio, 0.0, 1.0)
    filled_len = int(round(width * ratio))
    empty_len = width - filled_len

    if ratio < 0.60:
        fill_color = colors["GREEN"]
    elif ratio < 0.85:
        fill_color = colors["YELLOW"]
    else:
        fill_color = colors["RED"]

    bar_filled = f"{fill_color}{BLOCK_FULL * filled_len}{colors['RESET']}"
    bar_empty = f"{colors['DARK_GRAY']}{BLOCK_TRACK * empty_len}{colors['RESET']}"
    return f"{colors['GRAY']}{BLOCK_BORDER_L}{colors['RESET']}{bar_filled}{bar_empty}{colors['GRAY']}{BLOCK_BORDER_R}{colors['RESET']}"


def render_mini_bar(ratio, width=16, colors=None):
    """Renders proportional mini-bars."""
    colors = colors or get_ansi_palette(False)
    ratio = clamp(ratio, 0.0, 1.0)
    filled_len = int(round(width * ratio))
    empty_len = width - filled_len
    bar_filled = f"{colors['GREEN']}{BLOCK_FULL * filled_len}{colors['RESET']}"
    bar_empty = f"{colors['DARK_GRAY']}{BLOCK_TRACK * empty_len}{colors['RESET']}"
    return f"{bar_filled}{bar_empty}"


def render_snapshot(mem, procs, group_procs=True, paused=False, enable_color=True):
    """Renders full memory and process screen with adaptive narrow terminal support."""
    colors = get_ansi_palette(enable_color)
    hostname = sanitize_text(socket.gethostname())
    now_str = datetime.now().strftime("%a %H:%M:%S")

    total = mem.get("total", 0)
    available = mem.get("available", 0)
    used = mem.get("used", 0)
    used_pct = percentage(used, total)

    cols = shutil.get_terminal_size((80, 24)).columns
    bar_width = max(8, min(42, cols - 15))

    lines = []

    # 1. Header
    header = f"{colors['CYAN']}{colors['BOLD']}RAM USAGE{colors['RESET']} {colors['GRAY']}—{colors['RESET']} {colors['WHITE']}{hostname}{colors['RESET']}  {colors['GRAY']}{now_str}{colors['RESET']}"
    if paused:
        header += f"  {colors['YELLOW']}[PAUSED]{colors['RESET']}"
    lines.append(header)

    # 2. Main Bar
    bar_str = render_bar(used / total if total > 0 else 0, width=bar_width, colors=colors)
    pct_color = colors["GREEN"] if used_pct < 60 else (colors["YELLOW"] if used_pct < 85 else colors["RED"])
    lines.append(f"{bar_str} {pct_color}{colors['BOLD']}{used_pct:.1f}%{colors['RESET']}")
    lines.append("")

    # 3. Memory Metrics Table
    lines.append(
        f"{colors['WHITE']}{colors['BOLD']}Used{colors['RESET']}    {colors['GREEN']}{format_bytes(used):<10}{colors['RESET']} "
        f"{colors['WHITE']}{colors['BOLD']}Available{colors['RESET']}  {colors['GREEN']}{format_bytes(available):<10}{colors['RESET']} "
        f"{colors['WHITE']}{colors['BOLD']}Total{colors['RESET']}   {colors['WHITE']}{format_bytes(total)}{colors['RESET']}"
    )

    # Commit metric
    if mem.get("commit_as") is not None and mem.get("commit_limit") is not None:
        commit_as = mem["commit_as"]
        commit_limit = mem["commit_limit"]
        commit_pct = percentage(commit_as, commit_limit)
        lines.append(f"{colors['WHITE']}{colors['BOLD']}Commit{colors['RESET']}  {format_bytes(commit_as)} / {format_bytes(commit_limit)}  {colors['GRAY']}({commit_pct:.0f}% of commit limit){colors['RESET']}")
    else:
        lines.append(f"{colors['WHITE']}{colors['BOLD']}Commit{colors['RESET']}  N/A  {colors['GRAY']}(unsupported on macOS/platform){colors['RESET']}")

    # Cache metric
    cached_val = mem.get("cached")
    if cached_val is not None:
        lines.append(f"{colors['WHITE']}{colors['BOLD']}Cached{colors['RESET']}  {format_bytes(cached_val):<10} {colors['GRAY']}(cache + reclaimable estimate){colors['RESET']}")
    else:
        lines.append(f"{colors['WHITE']}{colors['BOLD']}Cached{colors['RESET']}  N/A        {colors['GRAY']}(unsupported on platform / API error){colors['RESET']}")

    # Swap metric
    swap_used = mem.get("swap_used")
    swap_total = mem.get("swap_total", 0)
    swap_desc = mem.get("swap_desc", "")
    if swap_used is not None:
        lines.append(f"{colors['WHITE']}{colors['BOLD']}Swap{colors['RESET']}    {format_bytes(swap_used)} / {format_bytes(swap_total)}   {colors['GRAY']}({swap_desc}){colors['RESET']}")
    else:
        lines.append(f"{colors['WHITE']}{colors['BOLD']}Swap{colors['RESET']}    {format_bytes(swap_total)} capacity   {colors['GRAY']}({swap_desc}){colors['RESET']}")

    lines.append("")

    # 4. Process Ranking
    mode_str = "RESIDENT SET" if group_procs else "PROCESS PID"
    lines.append(f"{colors['CYAN']}{colors['BOLD']}TOP {len(procs)} PROCESSES BY {mode_str}{colors['RESET']}")

    max_rss = procs[0]["rss"] if procs else 1
    proc_sum_rss = sum(p["rss"] for p in procs)
    proc_sum_pct = percentage(proc_sum_rss, total)

    name_col_width = max(10, min(19, cols - 35))
    mini_bar_width = max(6, min(16, cols - 40))

    for p in procs:
        count_str = f" ({p['count']})" if p.get("count", 1) > 1 else ""
        name_full = f"{p['name']}{count_str}"
        name_disp = (name_full[:name_col_width - 1] + "~") if len(name_full) > name_col_width else name_full.ljust(name_col_width)

        rss_str = format_bytes(p["rss"], precision=1).rjust(9)
        p_pct = percentage(p["rss"], total)
        mini_bar = render_mini_bar(p["rss"] / max_rss if max_rss > 0 else 0, width=mini_bar_width, colors=colors)

        lines.append(f"{colors['WHITE']}{name_disp}{colors['RESET']} {colors['GREEN']}{rss_str}{colors['RESET']}  {mini_bar}  {colors['GRAY']}{p_pct:>4.1f}%{colors['RESET']}")

    lines.append("")
    lines.append(f"{colors['GRAY']}These {len(procs)} account for  {colors['WHITE']}{format_bytes(proc_sum_rss)} ({proc_sum_pct:.0f}% of installed RAM){colors['RESET']}")

    return "\n".join(lines)


# ---------------------------------------------------------------------------
# CLI & Main Loop
# ---------------------------------------------------------------------------

def parse_arguments(args=None):
    parser = argparse.ArgumentParser(
        prog="ram",
        description=f"ram-tui v{__version__} - Real-time terminal memory monitor for Linux, macOS & Windows"
    )
    parser.add_argument("-r", "--rate", type=int, default=100, help="Refresh interval in milliseconds (20–2000, default: 100)")
    parser.add_argument("-n", "--count", type=int, default=8, help="Number of top processes (1–10000, default: 8)")
    parser.add_argument("-1", "--once", action="store_true", help="Output one snapshot and exit")
    parser.add_argument("--json", action="store_true", help="Output one JSON snapshot and exit")
    parser.add_argument("--no-group", action="store_true", help="Show individual process PIDs instead of grouping")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s v{__version__}")
    parsed = parser.parse_args(args)

    if parsed.rate < 20 or parsed.rate > 2000:
        parser.error("refresh rate must be between 20 and 2000 ms")
    if parsed.count < 1 or parsed.count > 10000:
        parser.error("process count must be between 1 and 10000")

    return parsed


def main():
    args = parse_arguments()
    term = TerminalManager()

    # If running in non-TTY pipe without explicit flags, degrade cleanly to one-shot
    if not term.is_tty and not args.json and not args.once:
        args.once = True

    # JSON Snapshot Mode
    if args.json:
        mem = get_meminfo()
        procs = get_processes(group_by_name=not args.no_group, limit=args.count)
        payload = {
            "timestamp": datetime.now().astimezone().isoformat(),
            "hostname": sanitize_text(socket.gethostname()),
            "os": SYSTEM_OS,
            "version": __version__,
            "memory": mem,
            "top_processes": procs
        }
        print(json.dumps(payload, indent=2))
        return

    # One-Shot Mode
    if args.once:
        mem = get_meminfo()
        procs = get_processes(group_by_name=not args.no_group, limit=args.count)
        color_enabled = should_use_color(is_interactive=False)
        print(render_snapshot(mem, procs, group_procs=not args.no_group, paused=False, enable_color=color_enabled))
        return

    # Interactive TUI Mode
    def cleanup_and_exit(signum=None, frame=None):
        term.restore()
        sys.exit(0)

    try:
        signal.signal(signal.SIGINT, cleanup_and_exit)
        signal.signal(signal.SIGTERM, cleanup_and_exit)
    except Exception:
        pass

    refresh_ms = args.rate
    proc_count = args.count
    group_procs = not args.no_group
    paused = False
    color_enabled = should_use_color(is_interactive=True)

    term.setup_raw()

    try:
        next_deadline = time.monotonic()

        while True:
            # Handle interactive hotkeys
            ch = term.check_key()
            if ch:
                if ch in ("q", "Q", "\x03"):
                    break
                elif ch in ("p", "P", " "):
                    paused = not paused
                elif ch in ("+", "="):
                    refresh_ms = max(20, refresh_ms - 25)
                elif ch in ("-", "_"):
                    refresh_ms = min(2000, refresh_ms + 50)
                elif ch == "1":
                    group_procs = True
                elif ch == "2":
                    group_procs = False

            if not paused:
                mem = get_meminfo()
                procs = get_processes(group_by_name=group_procs, limit=proc_count)
                output = render_snapshot(mem, procs, group_procs=group_procs, paused=paused, enable_color=color_enabled)
                try:
                    sys.stdout.write(f"\033[H\033[J{output}\n")
                    sys.stdout.flush()
                except BrokenPipeError:
                    break

            # Monotonic scheduling
            next_deadline += (refresh_ms / 1000.0)
            sleep_duration = next_deadline - time.monotonic()
            if sleep_duration > 0:
                time.sleep(sleep_duration)
            else:
                next_deadline = time.monotonic()

    except KeyboardInterrupt:
        pass
    finally:
        term.restore()


if __name__ == "__main__":
    main()
