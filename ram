def render_meter_track(ratio, width=32, pal=None, symbol="block", color=None):
    """Renders progress bar with sub-character accuracy in Block or Braille style."""
    pal = pal or get_palette("monochrome", False)
    ratio = clamp(ratio, 0.0, 1.0)
    width = max(1, width)

    if color is not None:
        c = color
    else:
        if ratio < 0.60:
            c = pal["GOOD"]
        elif ratio < 0.85:
            c = pal["WARNING"]
        else:
            c = pal["CRITICAL"]

    if symbol == "braille":
        total_steps = int(round(ratio * width * 2))
        full_blocks = total_steps // 2
        rem_steps = total_steps % 2
        empty_blocks = max(0, width - full_blocks - (1 if rem_steps > 0 else 0))
        frac_char = "⡇" if rem_steps == 1 else ""
        filled_part = f"{c}{'⣿' * full_blocks}{frac_char}{pal['RESET']}"
        empty_part = f"{pal['TRACK']}{BLOCK_TRACK * empty_blocks}{pal['RESET']}"
        return f"{filled_part}{empty_part}"
    else:
        total_eighths = int(round(ratio * width * 8))
        full_blocks = total_eighths // 8
        rem_eighths = total_eighths % 8
        empty_blocks = max(0, width - full_blocks - (1 if rem_eighths > 0 else 0))
        filled_part = f"{c}{BLOCK_FULL * full_blocks}{BLOCK_FRACTIONS[rem_eighths]}{pal['RESET']}"
        empty_part = f"{pal['TRACK']}{BLOCK_TRACK * empty_blocks}{pal['RESET']}"
        return f"{filled_part}{empty_part}"


def render_snapshot(mem, procs, group_procs=True, paused=False, mode="hero", theme="default", symbol="block", enable_color=True, show_help=False, update_notice=None):
    """Renders dashboard with 2D physical terminal cell bounds (C-001/C-002) and active help overlay (C-003)."""
    pal = get_palette(theme, enable_color)
    hostname = sanitize_text(socket.gethostname())
    now_str = datetime.now().strftime("%H:%M:%S")

    total = mem.get("total", 0)
    available = mem.get("available", 0)
    used = mem.get("used", 0)
    used_pct = percentage(used, total)

    term_size = shutil.get_terminal_size((80, 24))
    cols = max(16, term_size.columns)
    rows = max(1, term_size.lines)

    r = pal["RESET"]
    t = pal["TEXT"]
    h = pal["HEADER"]
    a = pal["ACCENT"]
    g = pal["GOOD"]
    w = pal["WARNING"]
    crit = pal["CRITICAL"]
    m = pal["MUTED"]
    dim = pal["DIM"]
    bold = pal["BOLD"]

    # 1. TINY / ULTRA-SHORT VIEWPORTS (< 4 rows)
    if mode == "tiny" or rows <= 3:
        used_str = format_bytes(used, precision=1)
        total_str = format_bytes(total, precision=1)
        res = clamp_line_to_cols(f"RAM: {used_str} / {total_str} ({used_pct:.1f}%)", cols)
        if show_help and rows >= 2:
            help_line = clamp_line_to_cols(f"{m}q:quit p:pause t:theme s:symbol m:mode +/-:rate h:help{r}", cols)
            res += f"\n{help_line}"
        return res

    # 2. MINI / SHORT VIEWPORTS (< 7 rows)
    if mode == "mini" or rows < 7:
        ui_cols = min(cols, 64)
        pad_left = (cols - ui_cols) // 2
        margin = " " * pad_left
        bar_w = max(4, min(ui_cols - 28, 44))
        meter = render_meter_track(used / total if total > 0 else 0, width=bar_w, pal=pal, symbol=symbol)
        pct_color = g if used_pct < 60 else (w if used_pct < 85 else crit)
        line1 = clamp_line_to_cols(f"{margin}{h}{bold}RAM{r}  {meter}  {pct_color}{bold}{used_pct:>5.1f}%{r}  {t}{format_bytes(used, 1)}{r}{m}/{r}{t}{format_bytes(total, 1)}{r}", cols)
        if show_help and rows >= 2:
            line2 = clamp_line_to_cols(f"{margin}{m}{dim}q:quit p:pause t:theme s:symbol m:mode 1/2:group +/-:rate h:help{r}", cols)
            return f"{line1}\n{line2}"
        return line1

    # 3. HERO & COMPACT MODES (Centered & dynamic width bounded)
    ui_cols = min(cols, 80)
    pad_left = (cols - ui_cols) // 2
    margin = " " * pad_left

    lines = []
    rule = f"{m}{dim}{'─' * ui_cols}{r}"

    # Header line
    state_str = f"  {w}{bold}paused{r}" if paused else ""
    clock = f"{m}{now_str}{r}"
    clock_w = visible_cell_width(clock)

    if ui_cols >= 64:
        header_left = (
            f"{h}{bold}RAM{r}  {m}·{r}  {t}{truncate_plain_cells(hostname, 16)}{r}  {m}·{r}  "
            f"{m}{SYSTEM_OS} {platform.machine()}{r}  {m}·{r}  {a}{theme}{r}{state_str}"
        )
    elif ui_cols >= 44:
        header_left = f"{h}{bold}RAM{r}  {m}·{r}  {t}{truncate_plain_cells(hostname, 12)}{r}  {m}·{r}  {a}{theme}{r}{state_str}"
    else:
        header_left = f"{h}{bold}RAM{r}  {m}·{r}  {a}{theme}{r}{state_str}"

    left_w = visible_cell_width(header_left)
    if left_w + clock_w + 2 <= ui_cols:
        gap = ui_cols - left_w - clock_w
        lines.append(f"{header_left}{' ' * gap}{clock}")
    elif left_w <= ui_cols:
        lines.append(header_left)
    else:
        lines.append(clamp_line_to_cols(header_left, ui_cols))

    lines.append(rule)

    # Hero usage bar
    bar_width = max(4, min(ui_cols - 16, 64))
    meter = render_meter_track(used / total if total > 0 else 0, width=bar_width, pal=pal, symbol=symbol)
    pct_color = g if used_pct < 60 else (w if used_pct < 85 else crit)
    lines.append(clamp_line_to_cols(meter, ui_cols))
    lines.append(clamp_line_to_cols(f"{pct_color}{bold}{used_pct:>5.1f}%{r}  {t}{bold}{format_bytes(used, 2)}{r}{m} used of {r}{t}{format_bytes(total, 2)}{r}", ui_cols))

    # Metrics Breakdown Budgeting
    footer_reserve = 2
    commit_str = f"{format_bytes(mem.get('commit_as') or 0, 1)}/{format_bytes(mem.get('commit_limit') or total, 1)}" if mem.get("commit_as") is not None else "N/A"
    cached_str = format_bytes(mem.get("cached", 0), 1) if mem.get("cached") is not None else "N/A"
    swap_str = f"{format_bytes(mem.get('swap_used') or 0, 1)} ({mem.get('swap_desc', '')})"

    # Only include breakdown grid if it fits comfortably within terminal rows
    if rows >= len(lines) + 2 + footer_reserve:
        if rows >= 22:
            lines.append("")

        if ui_cols >= 76:
            lines.append(clamp_line_to_cols(f"{m}USED       AVAILABLE   TOTAL      COMMIT          CACHED    SWAP{r}", ui_cols))
            lines.append(clamp_line_to_cols(f"{g}{bold}{format_bytes(used, 2):<11}{r}{t}{bold}{format_bytes(available, 2):<12}{r}{t}{bold}{format_bytes(total, 2):<11}{r}{t}{commit_str:<16}{r}{t}{cached_str:<10}{r}{t}{swap_str}{r}", ui_cols))
        elif ui_cols >= 44:
            lines.append(clamp_line_to_cols(f"{m}USED          AVAILABLE     TOTAL{r}", ui_cols))
            lines.append(clamp_line_to_cols(f"{g}{bold}{format_bytes(used, 2):<14}{r}{t}{bold}{format_bytes(available, 2):<14}{r}{t}{bold}{format_bytes(total, 2):<14}{r}", ui_cols))
        else:
            lines.append(clamp_line_to_cols(f"{m}USED:{r} {g}{bold}{format_bytes(used, 1)}{r}  {m}AVAIL:{r} {t}{bold}{format_bytes(available, 1)}{r}", ui_cols))

    # Process Ranking (HERO mode only, strictly clamped to remaining space)
    if mode == "hero" and procs:
        needed_for_proc_header = 1
        available_slots = max(0, rows - len(lines) - needed_for_proc_header - footer_reserve)
        visible_procs = procs[:available_slots] if available_slots > 0 else []

        if visible_procs:
            if rows >= 24:
                lines.append("")
            mode_label = "RESIDENT SET" if group_procs else "PID"
            hdr_title = f"PROCESS ({mode_label})" if ui_cols >= 64 else "PROCESS"
            hdr_w = visible_cell_width(hdr_title)

            if ui_cols >= 80:
                name_w = max(hdr_w, min(ui_cols - 38, 24))
                p_bar_w = max(4, min(ui_cols - name_w - 24, 20))
            elif ui_cols >= 64:
                name_w = max(hdr_w, 22)
                p_bar_w = max(4, ui_cols - name_w - 24)
            else:
                name_w = max(8, ui_cols - 30)
                p_bar_w = max(4, ui_cols - name_w - 24)

            hdr_name = pad_plain_cells(hdr_title, name_w, align="left")
            hdr_line = f"{m}{hdr_name}   {'RSS':>9}   {'USAGE':<{p_bar_w}}   {'SHARE':>6}{r}"
            lines.append(clamp_line_to_cols(hdr_line, ui_cols))

            for p in visible_procs:
                count_str = f" ({p['count']})" if p.get("count", 1) > 1 else ""
                name_full = f"{p['name']}{count_str}"
                name_disp = truncate_plain_cells(name_full, name_w)
                name_padded = pad_plain_cells(name_disp, name_w, align="left")

                rss_str = format_bytes(p["rss"], precision=1).rjust(9)
                p_pct = percentage(p["rss"], total)
                p_pct_str = f"{p_pct:>5.1f}%"
                p_color = g if p_pct < 40 else (w if p_pct < 70 else crit)
                p_ratio = p["rss"] / max(1, procs[0]["rss"])
                p_meter = render_meter_track(p_ratio, width=p_bar_w, pal=pal, symbol=symbol, color=p_color)

                p_line = f"{t}{name_padded}{r}   {g}{rss_str}{r}   {p_meter}   {m}{p_pct_str:>6}{r}"
                lines.append(clamp_line_to_cols(p_line, ui_cols))

    # Footer & Help Overlay (C-003)
    lines.append(rule)
    if show_help:
        lines.append(clamp_line_to_cols(f"{h}{bold}HOTKEYS:{r} {t}q{r} quit  {t}p/space{r} pause  {t}t{r} theme  {t}s{r} symbol  {t}m{r} mode  {t}1/2{r} group  {t}+/-{r} rate  {t}h{r} close", ui_cols))
    else:
        footer_text = f"{m}{dim}q quit   p pause   t theme   s symbol   m mode   1/2 group   +/- rate   h help{r}"
        if update_notice:
            footer_text += f"  {w}{update_notice}{r}"
        lines.append(clamp_line_to_cols(footer_text, ui_cols))

    # Guaranteed 2D Physical Safety Invariant:
    # 1. Every line is centered with margin and clamped to <= cols printable cells (prevent horizontal wrap).
    # 2. Total lines <= rows (prevent vertical scroll).
    clamped_lines = [clamp_line_to_cols(f"{margin}{line}", cols) for line in lines]
    if len(clamped_lines) > rows:
        clamped_lines = clamped_lines[:rows]

    return "\n".join(clamped_lines)


# ---------------------------------------------------------------------------
# CLI & Main Loop
# ---------------------------------------------------------------------------

def parse_arguments(args=None):
    parser = argparse.ArgumentParser(
        prog="ram",
        description=f"ram-tui v{__version__} - Minimalist real-time terminal memory monitor for Linux, macOS & Windows"
    )
    parser.add_argument("-r", "--rate", type=int, default=50, help="Refresh interval in milliseconds (20–2000, default: 50)")
    parser.add_argument("-n", "--count", type=int, default=8, help="Number of top processes (1–10000, default: 8)")
    parser.add_argument("-1", "--once", action="store_true", help="Output one snapshot and exit")
    parser.add_argument("--json", action="store_true", help="Output one JSON snapshot and exit")
    parser.add_argument("--no-group", action="store_true", help="Show individual process PIDs instead of grouping")
    
    # Display Modes
    parser.add_argument("--compact", action="store_true", help="Compact mode: memory meters only, no process list")
    parser.add_argument("--mini", action="store_true", help="Mini mode: single usage bar + percentage only")
    parser.add_argument("--tiny", action="store_true", help="Tiny mode: single line output for status bars (Waybar/tmux)")
    
    # Theme Engine & Graph Symbol
    parser.add_argument("--theme", choices=THEME_NAMES, default="default", help=f"Color theme ({', '.join(THEME_NAMES)})")
    parser.add_argument("--symbol", choices=GRAPH_SYMBOLS, default="block", help="Meter graph style: 'block' or 'braille' (default: block)")
    
    # In-Place Updater
    parser.add_argument("--update", action="store_true", help="Update ram-tui to latest release in-place and exit")
    parser.add_argument("--force", action="store_true", help="Force in-place update even if installed via a package manager")
    parser.add_argument("--check-update", action="store_true", help="Check for updates and exit")
    parser.add_argument("--no-update-check", action="store_true", help="Disable background update check")
    
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s v{__version__}")
    
    parsed = parser.parse_args(args)

    modes_set = [m for m in [parsed.compact, parsed.mini, parsed.tiny] if m]
    if len(modes_set) > 1:
        parser.error("cannot specify multiple display modes (--compact, --mini, --tiny)")

    if parsed.rate < 20 or parsed.rate > 2000:
        parser.error("refresh rate must be between 20 and 2000 ms")
    if parsed.count < 1 or parsed.count > 10000:
        parser.error("process count must be between 1 and 10000")

    return parsed


def main():
    if hasattr(signal, "SIGPIPE"):
        try:
            signal.signal(signal.SIGPIPE, signal.SIG_DFL)
        except Exception:
            pass

    args = parse_arguments()
    term = TerminalManager()

    update_manager = UpdateManager(
        current_version=__version__,
        disabled=args.no_update_check,
    )

    if args.update:
        ok, msg = update_manager.perform_update(force=args.force)
        sys.stdout.write(msg + "\n")
        sys.exit(0 if ok else 1)

    if args.check_update:
        try:
            latest, has_update = update_manager.check_now()
            if has_update:
                sys.stdout.write(f"Update available: v{__version__} -> v{latest} (run 'ram --update')\n")
            else:
                sys.stdout.write(f"ram-tui is up to date (v{__version__})\n")
            sys.exit(0)
        except Exception as exc:
            sys.stderr.write(f"Failed to check for updates: {exc}\n")
            sys.exit(1)

    current_mode = "hero"
    if args.compact:
        current_mode = "compact"
    elif args.mini:
        current_mode = "mini"
    elif args.tiny:
        current_mode = "tiny"

    current_theme = args.theme
    current_symbol = args.symbol

    if not term.is_tty and not args.json and not args.once:
        args.once = True

    # JSON Snapshot Mode
    if args.json:
        try:
            mem = get_meminfo()
            procs = get_processes(group_by_name=not args.no_group, limit=args.count)
            payload = {
                "timestamp": datetime.now().astimezone().isoformat(),
                "hostname": sanitize_text(socket.gethostname()),
                "os": SYSTEM_OS,
                "version": __version__,
                "memory": mem,
                "top_processes": procs
            }
            sys.stdout.write(json.dumps(payload, indent=2) + "\n")
            sys.stdout.flush()
        except BrokenPipeError:
            try:
                sys.stdout.close()
            except Exception:
                pass
            sys.exit(0)
        return

    # One-Shot Mode
    if args.once:
        try:
            mem = get_meminfo()
            procs = get_processes(group_by_name=not args.no_group, limit=args.count) if current_mode == "hero" else []
            color_enabled = should_use_color(is_interactive=False)
            output = render_snapshot(mem, procs, group_procs=not args.no_group, paused=False, mode=current_mode, theme=current_theme, symbol=current_symbol, enable_color=color_enabled)
            sys.stdout.write(output + "\n")
            sys.stdout.flush()
        except BrokenPipeError:
            try:
                sys.stdout.close()
            except Exception:
                pass
            sys.exit(0)
        return

    # Interactive TUI Mode
    def cleanup_and_exit(signum=None, frame=None):
        term.restore()
        sys.exit(0)

    try:
        signal.signal(signal.SIGINT, cleanup_and_exit)
        signal.signal(signal.SIGTERM, cleanup_and_exit)
    except Exception:
        pass

    def handle_resize(signum=None, frame=None):
        try:
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.flush()
        except Exception:
            pass

    if hasattr(signal, "SIGWINCH"):
        try:
            signal.signal(signal.SIGWINCH, handle_resize)
        except Exception:
            pass

    refresh_ms = args.rate
    proc_count = args.count
    group_procs = not args.no_group
    paused = False
    show_help = False
    color_enabled = should_use_color(is_interactive=True)
    last_term_size = None

    def draw_frame(output_text):
        nonlocal last_term_size
        try:
            current_term_size = shutil.get_terminal_size()
            if last_term_size is not None and current_term_size != last_term_size:
                sys.stdout.write("\033[2J\033[H")
            last_term_size = current_term_size

            formatted_lines = [f"{line}\033[K" for line in output_text.splitlines()]
            sys.stdout.write(f"\033[H{chr(10).join(formatted_lines)}\033[J")
            sys.stdout.flush()
        except BrokenPipeError:
            return False
        return True

    term.setup_raw()
    update_manager.start_background_check()

    try:
        while True:
            # 1. Render snapshot
            if not paused:
                mem = get_meminfo()
                procs = get_processes(group_by_name=group_procs, limit=proc_count) if current_mode == "hero" else []
                update_notice = update_manager.get_notification()
                output = render_snapshot(
                    mem, procs,
                    group_procs=group_procs,
                    paused=paused,
                    mode=current_mode,
                    theme=current_theme,
                    symbol=current_symbol,
                    enable_color=color_enabled,
                    show_help=show_help,
                    update_notice=update_notice
                )
                if not draw_frame(output):
                    break

            # 2. Responsive non-blocking select wait for user keystrokes
            keys = term.get_keys(timeout=refresh_ms / 1000.0)
            re_render_needed = False
            for ch in keys:
                if ch in ("q", "Q", "\x03"):
                    cleanup_and_exit()
                elif ch in ("p", "P", " "):
                    paused = not paused
                    re_render_needed = True
                elif ch in ("+", "="):
                    refresh_ms = max(20, refresh_ms - 25)
                    re_render_needed = True
                elif ch in ("-", "_"):
                    refresh_ms = min(2000, refresh_ms + 50)
                    re_render_needed = True
                elif ch == "1":
                    group_procs = True
                    re_render_needed = True
                elif ch == "2":
                    group_procs = False
                    re_render_needed = True
                elif ch in ("t", "T"):
                    idx = (THEME_NAMES.index(current_theme) + 1) % len(THEME_NAMES)
                    current_theme = THEME_NAMES[idx]
                    re_render_needed = True
                elif ch in ("s", "S"):
                    idx = (GRAPH_SYMBOLS.index(current_symbol) + 1) % len(GRAPH_SYMBOLS)
                    current_symbol = GRAPH_SYMBOLS[idx]
                    re_render_needed = True
                elif ch in ("m", "M"):
                    idx = (CYCLING_MODES.index(current_mode) + 1) % len(CYCLING_MODES) if current_mode in CYCLING_MODES else 0
                    current_mode = CYCLING_MODES[idx]
                    re_render_needed = True
                elif ch in ("h", "H", "?"):
                    show_help = not show_help
                    re_render_needed = True

            if re_render_needed:
                mem = get_meminfo()
                procs = get_processes(group_by_name=group_procs, limit=proc_count) if current_mode == "hero" else []
                update_notice = update_manager.get_notification()
                output = render_snapshot(
                    mem, procs,
                    group_procs=group_procs,
                    paused=paused,
                    mode=current_mode,
                    theme=current_theme,
                    symbol=current_symbol,
                    enable_color=color_enabled,
                    show_help=show_help,
                    update_notice=update_notice
                )
                if not draw_frame(output):
                    break

    except KeyboardInterrupt:
        pass
    finally:
        term.restore()


if __name__ == "__main__":
    main()

