def get_linux_proc_starttime(pid):
    try:
        with open(f"/proc/{pid}/stat", "r") as f:
            content = f.read()
        rparen = content.rfind(")")
        if rparen != -1:
            fields = content[rparen + 2:].split()
            if len(fields) >= 20:
                return fields[19]
    except Exception:
        pass
    return None


def get_processes_linux(group_by_name=True, limit=8):
    global PID_NAME_CACHE
    procs = {}

    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except Exception:
        return []

    valid_keys = set()

    for pid in pids:
        try:
            starttime = get_linux_proc_starttime(pid)
            if starttime is None:
                continue

            cache_key = (pid, starttime)
            valid_keys.add(cache_key)

            with open(f"/proc/{pid}/statm", "r") as f:
                fields = f.read().split()
                if len(fields) < 2:
                    continue
                rss_bytes = int(fields[1]) * PAGE_SIZE
                if rss_bytes <= 0:
                    continue

            comm = PID_NAME_CACHE.get(cache_key)
            if not comm:
                try:
                    with open(f"/proc/{pid}/comm", "r") as f:
                        comm = f.read().strip()
                except Exception:
                    pass

                if not comm:
                    try:
                        with open(f"/proc/{pid}/cmdline", "rb") as f:
                            cmd = f.read().decode(errors="ignore").replace("\x00", " ").strip()
                            if cmd:
                                comm = os.path.basename(cmd.split()[0])
                    except Exception:
                        pass

                comm = sanitize_text(comm or f"PID {pid}")
                PID_NAME_CACHE[cache_key] = comm

            if group_by_name:
                if comm in procs:
                    procs[comm]["rss"] += rss_bytes
                    procs[comm]["count"] += 1
                else:
                    procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1, "pid": None}
            else:
                procs[pid] = {"name": f"{comm} [{pid}]", "rss": rss_bytes, "count": 1, "pid": int(pid)}

        except (PermissionError, ProcessLookupError, FileNotFoundError, ValueError):
            continue
        except Exception:
            continue

    PID_NAME_CACHE = {k: v for k, v in PID_NAME_CACHE.items() if k in valid_keys}
    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes_windows(group_by_name=True, limit=8):
    procs = {}
    try:
        class PROCESSENTRY32W(ctypes.Structure):
            _fields_ = [
                ("dwSize", ctypes.c_ulong),
                ("cntUsage", ctypes.c_ulong),
                ("th32ProcessID", ctypes.c_ulong),
                ("th32DefaultHeapID", ctypes.c_void_p),
                ("th32ModuleID", ctypes.c_ulong),
                ("cntThreads", ctypes.c_ulong),
                ("th32ParentProcessID", ctypes.c_ulong),
                ("pcPriClassBase", ctypes.c_long),
                ("dwFlags", ctypes.c_ulong),
                ("szExeFile", ctypes.c_wchar * 260),
            ]

        class PROCESS_MEMORY_COUNTERS(ctypes.Structure):
            _fields_ = [
                ("cb", ctypes.c_ulong),
                ("PageFaultCount", ctypes.c_ulong),
                ("PeakWorkingSetSize", ctypes.c_size_t),
                ("WorkingSetSize", ctypes.c_size_t),
                ("QuotaPeakPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t),
                ("QuotaNonPagedPoolUsage", ctypes.c_size_t),
                ("PagefileUsage", ctypes.c_size_t),
                ("PeakPagefileUsage", ctypes.c_size_t),
            ]

        k32 = ctypes.windll.kernel32
        psapi_mem = getattr(k32, "K32GetProcessMemoryInfo", None) or getattr(ctypes.windll.psapi, "GetProcessMemoryInfo", None)
        if psapi_mem:
            psapi_mem.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong]
            psapi_mem.restype = ctypes.c_int

        INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
        h_snap = k32.CreateToolhelp32Snapshot(0x00000002, 0)
        if not h_snap or h_snap == INVALID_HANDLE_VALUE or h_snap == -1:
            return []

        pe = PROCESSENTRY32W()
        pe.dwSize = ctypes.sizeof(PROCESSENTRY32W)

        if k32.Process32FirstW(h_snap, ctypes.byref(pe)):
            while True:
                pid = pe.th32ProcessID
                name = sanitize_text(pe.szExeFile)
                if pid > 0:
                    h_proc = k32.OpenProcess(0x0400 | 0x0010, False, pid)
                    if h_proc and h_proc != INVALID_HANDLE_VALUE:
                        try:
                            pmc = PROCESS_MEMORY_COUNTERS()
                            pmc.cb = ctypes.sizeof(PROCESS_MEMORY_COUNTERS)
                            if psapi_mem and psapi_mem(h_proc, ctypes.byref(pmc), pmc.cb):
                                rss_bytes = pmc.WorkingSetSize
                                if rss_bytes > 0:
                                    if group_by_name:
                                        if name in procs:
                                            procs[name]["rss"] += rss_bytes
                                            procs[name]["count"] += 1
                                        else:
                                            procs[name] = {"name": name, "rss": rss_bytes, "count": 1, "pid": None}
                                    else:
                                        procs[pid] = {"name": f"{name} [{pid}]", "rss": rss_bytes, "count": 1, "pid": pid}
                        finally:
                            k32.CloseHandle(h_proc)

                if not k32.Process32NextW(h_snap, ctypes.byref(pe)):
                    break

        k32.CloseHandle(h_snap)
    except Exception:
        pass

    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes_darwin(group_by_name=True, limit=8):
    procs = {}
    try:
        output = run_command(["ps", "-axo", "pid,rss,comm"], timeout=1.0)
        for line in output.splitlines()[1:]:
            parts = line.strip().split(maxsplit=2)
            if len(parts) == 3 and parts[1].isdigit():
                pid = int(parts[0])
                rss_bytes = int(parts[1]) * 1024
                comm = sanitize_text(os.path.basename(parts[2]))
                if rss_bytes <= 0:
                    continue

                if group_by_name:
                    if comm in procs:
                        procs[comm]["rss"] += rss_bytes
                        procs[comm]["count"] += 1
                    else:
                        procs[comm] = {"name": comm, "rss": rss_bytes, "count": 1, "pid": None}
                else:
                    procs[pid] = {"name": f"{comm} [{pid}]", "rss": rss_bytes, "count": 1, "pid": pid}
    except Exception:
        pass

    return heapq.nlargest(limit, procs.values(), key=lambda x: (x["rss"], x["name"], x.get("pid") or 0))


def get_processes(group_by_name=True, limit=8):
    if SYSTEM_OS == "Linux":
        return get_processes_linux(group_by_name=group_by_name, limit=limit)
    elif SYSTEM_OS == "Windows":
        return get_processes_windows(group_by_name=group_by_name, limit=limit)
    elif SYSTEM_OS == "Darwin":
        return get_processes_darwin(group_by_name=group_by_name, limit=limit)
    return get_processes_linux(group_by_name=group_by_name, limit=limit)


