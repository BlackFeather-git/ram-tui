# ANSI escape sequence regex for complete sequence removal
ANSI_ESCAPE_RE = re.compile(r"\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")

# Unicode bidirectional control characters to strip for terminal integrity
BIDI_CHARS = set("\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069")


# ---------------------------------------------------------------------------
# Unicode Cell Width & Display Arithmetic (C-001 / C-002)
# ---------------------------------------------------------------------------

def char_cell_width(ch):
    """Calculates terminal column display width for a single character or grapheme."""
    if ch in ("\u200d", "\u200b", "\ufeff") or unicodedata.combining(ch) or unicodedata.category(ch) in ("Cc", "Cf", "Cs"):
        return 0
    if unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    return 1


def visible_cell_width(s):
    """Returns exact printable terminal column width of a string (stripping ANSI escapes)."""
    if not s:
        return 0
    plain = ANSI_ESCAPE_RE.sub("", s)
    return sum(char_cell_width(c) for c in plain)


def truncate_plain_cells(text, max_cells, ellipsis="~"):
    """Truncates plain text to fit strictly within max_cells terminal columns."""
    if max_cells <= 0:
        return ""
    total_w = visible_cell_width(text)
    if total_w <= max_cells:
        return text
    el_width = visible_cell_width(ellipsis)
    target_w = max(0, max_cells - el_width)
    cur_width = 0
    result = []
    for c in text:
        w = char_cell_width(c)
        if cur_width + w > target_w:
            break
        result.append(c)
        cur_width += w
    return "".join(result) + ellipsis


def pad_plain_cells(text, target_cells, align="left"):
    """Pads a string with spaces to reach target_cells terminal column width."""
    if target_cells <= 0:
        return ""
    cur_w = visible_cell_width(text)
    if cur_w >= target_cells:
        return text
    pad = " " * (target_cells - cur_w)
    return (text + pad) if align == "left" else (pad + text)


def clamp_line_to_cols(line, max_cols):
    """Ensures a line (including ANSI codes) never exceeds max_cols display cells."""
    if max_cols <= 0:
        return ""
    w = visible_cell_width(line)
    if w <= max_cols:
        return line
    plain = ANSI_ESCAPE_RE.sub("", line)
    return truncate_plain_cells(plain, max_cols, ellipsis="")


